#!/usr/bin/env bash
set -uo pipefail

if [[ $# -ne 1 ]]; then
  echo 'usage: gdd-readiness CHANGE_DIRECTORY' >&2
  exit 2
fi

change_dir="$(cd "$1" && pwd -P)"
repo_root="$(cd "$(git -C "$change_dir" rev-parse --show-toplevel)" && pwd -P)"
script_dir="$(cd "$(dirname "$0")" && pwd -P)"
policy_file="$script_dir/../finding-policy.md"
workflow_state="$script_dir/gdd-workflow-state"
failures=0
MAX_SYMLINKS=40
temp_dir="$(mktemp -d)"

EXPECTED_POLICY_VERSION='Policy-Version: 1'

policy_headings=(
  '## Authority'
  '## Finding report'
  '## Finding states'
  '## Adjudication'
  '## Repair'
  '## Fable'
  '## Interruption'
  '## Role gates'
  '## Feature closing'
)

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{ print $1 }'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{ print $1 }'
  else
    return 127
  fi
}

sha256_file() {
  sha256_stream <"$1"
}

require_exact_policy_line() {
  local expected_line="$1"
  local count

  count="$(grep -Fxc -- "$expected_line" "$policy_file" 2>/dev/null || true)"
  if [[ "$count" -ne 1 ]]; then
    fail "GDD finding policy must contain exactly one $expected_line"
  fi
}

validate_policy_headings() {
  local heading
  local count

  for heading in "${policy_headings[@]}"; do
    count="$(grep -Fxc -- "$heading" "$policy_file" 2>/dev/null || true)"
    if [[ "$count" -ne 1 ]]; then
      fail "GDD finding policy is malformed: $heading"
    fi
  done
}

policy_workspace_dir() {
  local plan_file="$change_dir/plan.md"
  local plan_dir
  local slug

  plan_dir="$(cd "$(dirname "$plan_file")" && pwd -P)"
  slug="$(basename "$plan_file" .md)"
  if [[ "$slug" == 'plan' ]]; then
    slug="$(basename "$plan_dir")"
  fi
  printf '%s\n' "$repo_root/.superpowers/gdd/$slug"
}

validate_finding_policy() {
  local workspace_dir
  local snapshot_policy
  local snapshot_digest
  local saved_policy_sha256
  local recorded_policy_sha256

  workspace_dir="$(policy_workspace_dir)"
  snapshot_policy="$workspace_dir/finding-policy.md"
  snapshot_digest="$workspace_dir/finding-policy.sha256"

  if [[ -e "$snapshot_policy" || -e "$snapshot_digest" ]]; then
    if [[ ! -e "$snapshot_policy" || ! -e "$snapshot_digest" ]]; then
      fail 'saved GDD finding policy snapshot is incomplete'
      return
    fi

    if ! saved_policy_sha256="$(sha256_file "$snapshot_policy")"; then
      fail 'saved GDD finding policy snapshot cannot be hashed'
      return
    fi
    recorded_policy_sha256="$(tr -d '\r\n' <"$snapshot_digest")"
    if [[ "$saved_policy_sha256" != "$recorded_policy_sha256" ]]; then
      fail 'saved GDD finding policy snapshot does not match its recorded digest'
    fi
    return
  fi

  if [[ ! -s "$policy_file" ]]; then
    fail 'GDD finding policy is missing or empty'
    return
  fi

  require_exact_policy_line "$EXPECTED_POLICY_VERSION"
  validate_policy_headings
}

validate_workflow_state() {
  local format_version

  if [[ ! -x "$workflow_state" ]]; then
    fail 'GDD workflow state engine is missing or not executable'
    return
  fi

  if ! format_version="$("$workflow_state" "$change_dir/plan.md" format-version 2>/dev/null)"; then
    fail 'GDD workflow state engine cannot report its format version'
    return
  fi

  if [[ "$format_version" != 1 ]]; then
    fail "GDD workflow state engine reports unsupported format version: $format_version"
  fi
}

require_nonempty() {
  local relative_path="$1"

  [[ -s "$change_dir/$relative_path" ]] \
    || fail "required artifact is missing or empty: $relative_path"
}

trim() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

check_references() {
  local slice_number="$1"
  local field_name="$2"
  local reference_value="$3"
  local mapping_file="$4"
  local raw_reference
  local reference
  local -a references

  [[ "$reference_value" == 'N/A' ]] && return

  IFS=',' read -r -a references <<<"$reference_value"
  for raw_reference in "${references[@]}"; do
    reference="$(trim "$raw_reference")"
    if [[ -z "$reference" ]] || ! grep -Fqx -- "$reference" "$mapping_file"; then
      fail "tasks.md slice $slice_number $field_name reference is unresolved: $reference"
    fi
  done
}

resolve_physical_path() {
  local unresolved_path="$1"
  local physical_directory
  local link_target
  local link_count=0

  while :; do
    if ! physical_directory="$(cd "$(dirname "$unresolved_path")" 2>/dev/null && pwd -P)"; then
      return 1
    fi
    unresolved_path="$physical_directory/$(basename "$unresolved_path")"

    if [[ ! -L "$unresolved_path" ]]; then
      printf '%s\n' "$unresolved_path"
      return 0
    fi

    link_count=$((link_count + 1))
    if [[ "$link_count" -gt "$MAX_SYMLINKS" ]]; then
      return 1
    fi
    if ! link_target="$(readlink "$unresolved_path")"; then
      return 1
    fi

    case "$link_target" in
      /*)
        unresolved_path="$link_target"
        ;;
      *)
        unresolved_path="$(dirname "$unresolved_path")/$link_target"
        ;;
    esac
  done
}

has_passing_verdict() {
  local verdict_file="$1"
  local verdict_line
  local candidate
  local leading_decoration
  local trailing_decoration
  local decoration_character
  local permitted_decorations='*_`'

  while IFS= read -r verdict_line || [[ -n "$verdict_line" ]]; do
    candidate="$(trim "$verdict_line")"
    while [[ "$candidate" == \#* ]]; do
      candidate="${candidate#\#}"
    done
    candidate="$(trim "$candidate")"
    leading_decoration=''
    trailing_decoration=''

    while [[ -n "$candidate" && "$permitted_decorations" == *"${candidate:0:1}"* ]]; do
      decoration_character="${candidate:0:1}"
      leading_decoration="${leading_decoration}${decoration_character}"
      candidate="${candidate:1}"
    done
    candidate="$(trim "$candidate")"

    while [[ -n "$candidate" && "$permitted_decorations" == *"${candidate:${#candidate}-1:1}"* ]]; do
      decoration_character="${candidate:${#candidate}-1:1}"
      trailing_decoration="${decoration_character}${trailing_decoration}"
      candidate="${candidate:0:${#candidate}-1}"
    done
    candidate="$(trim "$candidate")"

    if [[ -n "$leading_decoration" || -n "$trailing_decoration" ]]; then
      [[ "$leading_decoration" == "$trailing_decoration" ]] || continue
    fi

    case "$candidate" in
      *.) candidate="${candidate%.}" ;;
      *!) candidate="${candidate%!}" ;;
      *:) candidate="${candidate%:}" ;;
    esac

    case "$candidate" in
      'PASS' | 'PASS WITH NOTES')
        return 0
        ;;
    esac
  done <"$verdict_file"

  return 1
}

make_comparison_keys() {
  local input_file="$1"
  local output_file="$2"
  local number
  local padding_width
  local padding

  while IFS= read -r number; do
    padding_width=$((comparison_width - ${#number}))
    printf -v padding '%*s' "$padding_width" ''
    padding="${padding// /0}"
    printf '%s%s\t%s\n' "$padding" "$number" "$number"
  done <"$input_file" >"$output_file"
}

comparison_width=1

find_comparison_width() {
  local input_file="$1"
  local number

  while IFS= read -r number; do
    if [[ "${#number}" -gt "$comparison_width" ]]; then
      comparison_width="${#number}"
    fi
  done <"$input_file"
}

for artifact in \
  proposal.md \
  design.md \
  gherkin.md \
  qa.md \
  tasks.md \
  plan.md \
  plan-validator-verdict.md; do
  require_nonempty "$artifact"
done

validate_finding_policy
validate_workflow_state

if ! awk '
  /^schema:[[:space:]]*/ {
    schema_count++
    if ($0 ~ /^schema:[[:space:]]*superpowers-bridge[[:space:]]*$/) {
      bridge_schema_count++
    }
  }
  END {
    exit !(schema_count == 1 && bridge_schema_count == 1)
  }
' "$change_dir/.openspec.yaml" 2>/dev/null; then
  fail '.openspec.yaml must select schema: superpowers-bridge'
fi

delta_spec="$(find "$change_dir/specs" -mindepth 2 -maxdepth 2 \
  -type f -name spec.md -size +0c -print -quit 2>/dev/null || true)"
if [[ -z "$delta_spec" ]]; then
  fail 'no nonempty delta spec found under specs/*/spec.md'
fi

if [[ -s "$change_dir/gherkin.md" ]]; then
  if grep -Eo '`[^`]+\.feature`' "$change_dir/gherkin.md" \
    >"$temp_dir/feature-paths.txt"; then
    :
  fi

  if [[ ! -s "$temp_dir/feature-paths.txt" ]]; then
    fail 'gherkin.md must map at least one repository-relative .feature file'
  else
    while IFS= read -r quoted_feature_path; do
      feature_path="${quoted_feature_path#\`}"
      feature_path="${feature_path%\`}"

      case "$feature_path" in
        /* | ../* | */../* | .. | */..)
          fail "mapped Gherkin feature is not repository-relative: $feature_path"
          ;;
        *)
          if ! physical_feature_path="$(resolve_physical_path "$repo_root/$feature_path")"; then
            fail "mapped Gherkin feature is not repository-relative: $feature_path"
          elif [[ "$physical_feature_path" != "$repo_root/"* ]]; then
            fail "mapped Gherkin feature is not repository-relative: $feature_path"
          elif [[ ! -s "$physical_feature_path" ]]; then
            fail "mapped Gherkin feature is missing: $feature_path"
          fi
          ;;
      esac
    done <"$temp_dir/feature-paths.txt"
  fi
fi

: >"$temp_dir/task-numbers.txt"
: >"$temp_dir/plan-numbers.txt"

if [[ -s "$change_dir/tasks.md" ]]; then
  awk '
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }

    function emit_slice() {
      if (slice_number != "") {
        gherkin_output=gherkin_value
        qa_output=qa_value
        if (gherkin_output == "") gherkin_output=" "
        if (qa_output == "") qa_output=" "
        printf "%s\t%d\t%d\t%d\t%d\t%d\t%d\t%s\t%d\t%s\n", \
          slice_number, state_count, queued_count, gate_count, executor_label_count, \
          executor_count, gherkin_count, gherkin_output, qa_count, qa_output
      }
    }

    /^## [1-9][0-9]*\. / {
      emit_slice()
      slice_number=$2
      sub(/\..*$/, "", slice_number)
      state_count=0
      queued_count=0
      gate_count=0
      executor_label_count=0
      executor_count=0
      gherkin_count=0
      gherkin_value=""
      qa_count=0
      qa_value=""
      in_slice=1
      next
    }

    in_slice && /^\*\*Slice state:\*\*/ {
      state_count++
      if ($0 == "**Slice state:** [ ] QUEUED") queued_count++
      next
    }

    in_slice && $0 == "- [ ] " slice_number ".V **Slice verification gate**" {
      gate_count++
      next
    }

    in_slice && /^\*\*Executor:\*\*/ {
      executor_label_count++
      executor_value=$0
      sub(/^\*\*Executor:\*\*[[:space:]]*/, "", executor_value)
      executor_value=trim(executor_value)
      if (executor_value != "") executor_count++
      next
    }

    in_slice && /^\*\*Gherkin scenarios:\*\*/ {
      gherkin_count++
      gherkin_value=$0
      sub(/^\*\*Gherkin scenarios:\*\*[[:space:]]*/, "", gherkin_value)
      gherkin_value=trim(gherkin_value)
      next
    }

    in_slice && /^\*\*QA procedures:\*\*/ {
      qa_count++
      qa_value=$0
      sub(/^\*\*QA procedures:\*\*[[:space:]]*/, "", qa_value)
      qa_value=trim(qa_value)
    }

    END {
      emit_slice()
    }
  ' "$change_dir/tasks.md" >"$temp_dir/slices.tsv"

  if [[ ! -s "$temp_dir/slices.tsv" ]]; then
    fail 'no recognized task slices'
  else
    while IFS=$'\t' read -r \
      slice_number \
      state_count \
      queued_count \
      gate_count \
      executor_label_count \
      executor_count \
      gherkin_count \
      gherkin_value \
      qa_count \
      qa_value; do
      printf '%s\n' "$slice_number" >>"$temp_dir/task-numbers.txt"
      gherkin_value="$(trim "$gherkin_value")"
      qa_value="$(trim "$qa_value")"

      if [[ "$state_count" -ne 1 || "$queued_count" -ne 1 ]]; then
        fail "tasks.md slice $slice_number must contain exactly one queued Slice state"
      fi
      if [[ "$gate_count" -ne 1 ]]; then
        fail "tasks.md slice $slice_number must contain exactly one unchecked $slice_number.V Slice verification gate"
      fi
      if [[ "$executor_label_count" -ne 1 || "$executor_count" -ne 1 ]]; then
        fail "tasks.md slice $slice_number must contain exactly one nonempty Executor"
      fi
      if [[ "$gherkin_count" -ne 1 || -z "$gherkin_value" ]]; then
        fail "tasks.md slice $slice_number must contain exactly one nonempty Gherkin scenarios label"
      elif [[ -s "$change_dir/gherkin.md" ]]; then
        check_references "$slice_number" 'Gherkin scenarios' "$gherkin_value" \
          "$change_dir/gherkin.md"
      fi
      if [[ "$qa_count" -ne 1 || -z "$qa_value" ]]; then
        fail "tasks.md slice $slice_number must contain exactly one nonempty QA procedures label"
      elif [[ -s "$change_dir/qa.md" ]]; then
        check_references "$slice_number" 'QA procedures' "$qa_value" \
          "$change_dir/qa.md"
      fi
    done <"$temp_dir/slices.tsv"
  fi
fi

if [[ -s "$change_dir/plan.md" ]]; then
  awk '
    /^## Task [1-9][0-9]*:/ {
      task_number=$0
      sub(/^## Task /, "", task_number)
      sub(/:.*/, "", task_number)
      print task_number
    }
  ' "$change_dir/plan.md" >"$temp_dir/plan-numbers.txt"
  if [[ ! -s "$temp_dir/plan-numbers.txt" ]]; then
    fail 'no recognized plan tasks'
  fi
fi

if [[ -s "$change_dir/tasks.md" && -s "$change_dir/plan.md" ]]; then
  sort -n "$temp_dir/task-numbers.txt" >"$temp_dir/task-numbers-sorted.txt"
  sort -n "$temp_dir/plan-numbers.txt" >"$temp_dir/plan-numbers-sorted.txt"

  while IFS= read -r duplicate_number; do
    [[ -n "$duplicate_number" ]] \
      && fail "tasks.md contains duplicate slice $duplicate_number"
  done < <(uniq -d "$temp_dir/task-numbers-sorted.txt")

  while IFS= read -r duplicate_number; do
    [[ -n "$duplicate_number" ]] \
      && fail "plan.md contains duplicate Task $duplicate_number"
  done < <(uniq -d "$temp_dir/plan-numbers-sorted.txt")

  if [[ -s "$temp_dir/task-numbers-sorted.txt" \
    && -s "$temp_dir/plan-numbers-sorted.txt" ]]; then
    find_comparison_width "$temp_dir/task-numbers-sorted.txt"
    find_comparison_width "$temp_dir/plan-numbers-sorted.txt"
    make_comparison_keys \
      "$temp_dir/task-numbers-sorted.txt" \
      "$temp_dir/task-comparison-keys.txt"
    make_comparison_keys \
      "$temp_dir/plan-numbers-sorted.txt" \
      "$temp_dir/plan-comparison-keys.txt"

    while IFS=$'\t' read -r _ missing_number; do
      [[ -n "$missing_number" ]] \
        && fail "tasks.md slice $missing_number has no matching plan.md Task $missing_number section"
    done < <(comm -23 \
      "$temp_dir/task-comparison-keys.txt" \
      "$temp_dir/plan-comparison-keys.txt")

    while IFS=$'\t' read -r _ unmatched_number; do
      [[ -n "$unmatched_number" ]] \
        && fail "plan.md Task $unmatched_number has no matching tasks.md slice $unmatched_number"
    done < <(comm -13 \
      "$temp_dir/task-comparison-keys.txt" \
      "$temp_dir/plan-comparison-keys.txt")
  fi
fi

if [[ -s "$change_dir/plan-validator-verdict.md" ]]; then
  if grep -Eq '(^|[^A-Z])(CHANGES REQUIRED|INCOMPLETE)($|[^A-Z])' \
    "$change_dir/plan-validator-verdict.md"; then
    fail 'plan-validator verdict does not pass'
  elif ! has_passing_verdict "$change_dir/plan-validator-verdict.md"; then
    fail 'plan-validator verdict does not pass'
  fi
fi

if [[ "$failures" -ne 0 ]]; then
  exit 1
fi

echo "PASS: OpenSpec change is ready for GDD: $change_dir"
