#!/usr/bin/env bash
# Create and project the append-only v1 GDD obligation journal.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  gdd-workflow-state PLAN_FILE init
  gdd-workflow-state PLAN_FILE status
  gdd-workflow-state PLAN_FILE next
  gdd-workflow-state PLAN_FILE format-version
  gdd-workflow-state PLAN_FILE claim OBLIGATION_ID ACTOR DISPATCH_FILE
  gdd-workflow-state PLAN_FILE accept RECEIPT RESULT_KIND EVIDENCE_FILE [SUPPORTING_FILE...]
  gdd-workflow-state PLAN_FILE accept-active OBLIGATION_ID RESULT_KIND EVIDENCE_FILE [SUPPORTING_FILE...]
  gdd-workflow-state PLAN_FILE release RECEIPT EVIDENCE_FILE
  gdd-workflow-state PLAN_FILE project
  gdd-workflow-state PLAN_FILE digest OUTPUT_FILE
  gdd-workflow-state PLAN_FILE complete EVIDENCE_FILE
EOF
  exit 2
}

fail() {
  printf 'gdd-workflow-state: %s\n' "$1" >&2
  exit 1
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  else
    sha256sum "$1" | awk '{ print $1 }'
  fi
}

sha256_values() {
  local value
  for value in "$@"; do
    case "$value" in
      *$'\t'*|*$'\r'*|*$'\n'*) fail 'scalar field values cannot contain tabs, carriage returns, or newlines' ;;
    esac
  done
  {
    printf '%s' "$1"
    shift
    for value in "$@"; do
      printf '\t%s' "$value"
    done
  } | {
    if command -v shasum >/dev/null 2>&1; then
      shasum -a 256 | awk '{ print $1 }'
    else
      sha256sum | awk '{ print $1 }'
    fi
  }
}

require_plan() {
  [ -f "$plan" ] || fail "no such plan file: $plan"
  tasks_file="$(dirname "$plan")/tasks.md"
  [ -f "$tasks_file" ] || fail "no tasks.md beside plan: $tasks_file"
}

read_slice_numbers() {
  awk '
    function stop(message) {
      print "gdd-workflow-state: " message > "/dev/stderr"
      failed = 1
      exit 1
    }
    function finish_slice() {
      if (!inside) {
        return
      }
      if (state_count != 1) {
        stop("slice " slice_number " must contain exactly one Slice state line")
      }
      if (state_line != "**Slice state:** [ ] QUEUED") {
        stop("slice " slice_number " has unsupported Slice state metadata: " state_line)
      }
      if (gate_count != 1) {
        stop("slice " slice_number " must contain exactly one Slice verification gate")
      }
    }
    /^## [1-9][0-9]*\. / {
      finish_slice()
      slice_number = $0
      sub(/^## /, "", slice_number)
      sub(/\. .*/, "", slice_number)
      if (seen[slice_number]++) {
        stop("duplicate slice number: " slice_number)
      }
      slices[++slice_count] = slice_number
      state_count = 0
      gate_count = 0
      state_line = ""
      inside = 1
      next
    }
    inside && /^\*\*Slice state:\*\*/ {
      state_count++
      state_line = $0
      next
    }
    inside && $0 == "- [ ] " slice_number ".V **Slice verification gate**" {
      gate_count++
    }
    END {
      if (!failed) {
        finish_slice()
      }
      if (!failed && slice_count == 0) {
        stop("tasks.md has no numbered slices")
      }
      if (!failed) {
        for (position = 1; position <= slice_count; position++) {
          print slices[position]
        }
      }
    }
  ' "$tasks_file"
}

compile_obligations() {
  local output_file=$1
  local slice_numbers
  slice_numbers=$(read_slice_numbers) || return 1

  printf '%s\n' 'obligation_id	scope	type	prerequisites	allowed_results	blocking_boundary	evidence_contract' >"$output_file"

  local prior_verified='-'
  local verified_obligations=''
  local slice_number
  while IFS= read -r slice_number; do
    [ -n "$slice_number" ] || continue
    local scope="slice-$slice_number"
    local implementer="slice-$slice_number-implementer"
    local review="slice-$slice_number-review"
    local cleaner="slice-$slice_number-cleaner"
    local architect="slice-$slice_number-architect"
    local hardener="slice-$slice_number-hardener"
    local qa="slice-$slice_number-qa"
    local final_suite="slice-$slice_number-final-suite"
    local verified="slice-$slice_number-verified"

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$implementer" "$scope" implementer "$prior_verified" 'PASS,FAIL' slice 'implementer-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$review" "$scope" review "$implementer" 'PASS,FAIL' slice 'review-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$cleaner" "$scope" cleaner "$review" 'PASS,FAIL' slice 'cleaner-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$architect" "$scope" architect "$cleaner" 'PASS,FAIL' slice 'architect-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$hardener" "$scope" hardener "$architect" 'PASS,FAIL' slice 'hardener-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$qa" "$scope" qa "$hardener" 'PASS,FAIL' slice 'qa-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$final_suite" "$scope" final-suite "$qa" 'PASS,FAIL' slice 'final-suite-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$verified" "$scope" verified "$final_suite" PASS slice 'verification-record' >>"$output_file"

    prior_verified=$verified
    if [ -z "$verified_obligations" ]; then
      verified_obligations=$verified
    else
      verified_obligations="$verified_obligations,$verified"
    fi
  done <<<"$slice_numbers"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-branch-review feature branch-review "$verified_obligations" 'PASS,FAIL' feature 'branch-review-report' >>"$output_file"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-security-review feature security-review "$verified_obligations" 'PASS,FAIL' feature 'security-review-report' >>"$output_file"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-findings-digest feature findings-digest 'feature-branch-review,feature-security-review' PASS feature 'findings-digest' >>"$output_file"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-complete feature complete feature-findings-digest PASS feature 'completion-evidence' >>"$output_file"
}

validate_obligations() {
  local obligations_file=$1
  [ -f "$obligations_file" ] || { printf '%s\n' 'obligations.tsv is missing' >&2; return 1; }

  awk -F '\t' '
    function invalid(message) {
      print "gdd-workflow-state: " message > "/dev/stderr"
      invalid_graph = 1
      exit 1
    }
    function visit(identifier, dependency_count, dependencies, position, dependency) {
      if (color[identifier] == 1) {
        invalid("obligation graph contains a cycle at " identifier)
      }
      if (color[identifier] == 2) {
        return
      }
      color[identifier] = 1
      if (prerequisites[identifier] != "-") {
        dependency_count = split(prerequisites[identifier], dependencies, ",")
        for (position = 1; position <= dependency_count; position++) {
          dependency = dependencies[position]
          visit(dependency)
        }
      }
      color[identifier] = 2
    }
    NR == 1 {
      expected = "obligation_id\tscope\ttype\tprerequisites\tallowed_results\tblocking_boundary\tevidence_contract"
      if ($0 != expected) {
        invalid("obligations.tsv has an invalid header")
      }
      next
    }
    {
      if (NF != 7) {
        invalid("obligation record must contain seven tab-separated fields")
      }
      if ($1 !~ /^(slice-[1-9][0-9]*-(implementer|review|cleaner|architect|hardener|qa|final-suite|verified)|feature-(branch-review|security-review|findings-digest|complete))$/) {
        invalid("obligation has an invalid ID: " $1)
      }
      if (seen[$1]++) {
        invalid("duplicate obligation ID: " $1)
      }
      prerequisites[$1] = $4
      identifiers[++count] = $1
    }
    END {
      if (NR == 0) {
        invalid("obligations.tsv is empty")
      }
      if (!invalid_graph) {
        for (identifier in prerequisites) {
          if (prerequisites[identifier] == "-") {
            continue
          }
          dependency_count = split(prerequisites[identifier], dependencies, ",")
          for (position = 1; position <= dependency_count; position++) {
            dependency = dependencies[position]
            if (!(dependency in prerequisites)) {
              invalid("obligation " identifier " references an unknown prerequisite: " dependency)
            }
          }
        }
      }
      if (!invalid_graph) {
        for (position = 1; position <= count; position++) {
          visit(identifiers[position])
        }
      }
    }
  ' "$obligations_file"
}

validate_event_chain() {
  local events_file=$1
  local events_root=$2
  [ -f "$events_file" ] || { printf '%s\n' 'events.tsv is missing' >&2; return 1; }
  local expected_header=$'sequence\trevision\tevent_id\tobligation_id\tkind\tactor\treceipt\tevidence_path\tevidence_sha256\tprevious_hash\tevent_hash'
  local header
  IFS= read -r header <"$events_file" || { printf '%s\n' 'events.tsv is empty' >&2; return 1; }
  [ "$header" = "$expected_header" ] || { printf '%s\n' 'events.tsv has an invalid header' >&2; return 1; }

  awk -F '\t' 'NR > 1 && NF != 11 { exit 1 }' "$events_file" \
    || { printf '%s\n' 'events.tsv contains a malformed record' >&2; return 1; }

  local expected_sequence=1
  local expected_revision=1
  local previous_hash='-'
  local active_receipt=''
  local event_line event_remainder
  local -a event_fields
  local sequence revision event_id obligation_id kind actor receipt evidence_path evidence_sha256 recorded_previous_hash event_hash
  while IFS= read -r event_line || [ -n "$event_line" ]; do
    [ -n "$event_line" ] || continue
    event_fields=()
    event_remainder=$event_line
    while [[ "$event_remainder" == *$'\t'* ]]; do
      event_fields+=("${event_remainder%%$'\t'*}")
      event_remainder=${event_remainder#*$'\t'}
    done
    event_fields+=("$event_remainder")
    sequence=${event_fields[0]}
    revision=${event_fields[1]}
    event_id=${event_fields[2]}
    obligation_id=${event_fields[3]}
    kind=${event_fields[4]}
    actor=${event_fields[5]}
    receipt=${event_fields[6]}
    evidence_path=${event_fields[7]}
    evidence_sha256=${event_fields[8]}
    recorded_previous_hash=${event_fields[9]}
    event_hash=${event_fields[10]}
    [ -n "$sequence" ] || continue
    case "$sequence:$revision" in
      *[!0-9:]*|:*|*:) printf '%s\n' 'event sequence and revision must be positive integers' >&2; return 1 ;;
    esac
    [ "$sequence" -eq "$expected_sequence" ] || { printf '%s\n' "event sequence gap at $sequence" >&2; return 1; }
    [ "$revision" -eq "$expected_revision" ] || { printf '%s\n' "event revision gap at $revision" >&2; return 1; }
    case "$kind" in CLAIM|ACCEPT|RELEASE|COMPLETE|SIDE|EvidenceInvalidated) ;; *) printf '%s\n' "unknown event kind: $kind" >&2; return 1 ;; esac
    if [ "$kind" = CLAIM ] && [ -z "$receipt" ]; then
      printf '%s\n' "claim receipt is empty at sequence $sequence" >&2
      return 1
    fi
    case "$evidence_path" in ''|/*|*'..'*|*$'\r'*|*$'\n'*) printf '%s\n' "invalid event evidence path: $evidence_path" >&2; return 1 ;; esac
    [ "$recorded_previous_hash" = "$previous_hash" ] || { printf '%s\n' "broken event hash chain at sequence $sequence" >&2; return 1; }
    [ -f "$events_root/$evidence_path" ] || { printf '%s\n' "event evidence is missing: $evidence_path" >&2; return 1; }
    [ "$(sha256_file "$events_root/$evidence_path")" = "$evidence_sha256" ] || { printf '%s\n' "event evidence digest does not match: $evidence_path" >&2; return 1; }
    local calculated_hash metadata_path metadata_digest=''
    case "$evidence_path" in
      events/event-*/*)
        metadata_path="$(dirname "$evidence_path")/metadata.tsv"
        [ -f "$events_root/$metadata_path" ] || { printf '%s\n' "event metadata is missing: $metadata_path" >&2; return 1; }
        validate_supporting_evidence "$event_id" "$events_root/$metadata_path" "$events_root" || return 1
        metadata_digest=$(sha256_file "$events_root/$metadata_path")
        ;;
    esac
    if [ -n "$metadata_digest" ]; then
      calculated_hash=$(sha256_values "$sequence" "$revision" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_sha256" "$recorded_previous_hash" "$metadata_digest")
    else
      calculated_hash=$(sha256_values "$sequence" "$revision" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_sha256" "$recorded_previous_hash")
    fi
    [ "$calculated_hash" = "$event_hash" ] || { printf '%s\n' "broken event hash at sequence $sequence" >&2; return 1; }
    case "$kind" in
      CLAIM)
        [ -z "$active_receipt" ] || { printf '%s\n' "overlapping claim at sequence $sequence" >&2; return 1; }
        active_receipt=$receipt
        ;;
      ACCEPT|RELEASE|COMPLETE)
        if [ "$receipt" = "$active_receipt" ]; then
          active_receipt=''
        fi
        ;;
    esac
    previous_hash=$event_hash
    expected_sequence=$((expected_sequence + 1))
    expected_revision=$((expected_revision + 1))
  done < <(tail -n +2 "$events_file")
}

validate_supporting_evidence() {
  local event_id=$1
  local metadata_file=$2
  local events_root=$3
  local supporting_count
  supporting_count=$(metadata_value "$metadata_file" supporting-evidence-count)
  [ -n "$supporting_count" ] || supporting_count=0
  case "$supporting_count" in *[!0-9]*|'') printf '%s\n' "invalid supporting evidence count for $event_id" >&2; return 1 ;; esac

  local supporting_index supporting_path supporting_digest expected_path
  supporting_index=1
  while [ "$supporting_index" -le "$supporting_count" ]; do
    supporting_path=$(metadata_value "$metadata_file" "supporting-evidence-$supporting_index-path")
    supporting_digest=$(metadata_value "$metadata_file" "supporting-evidence-$supporting_index-sha256")
    expected_path="events/$event_id/supporting-$supporting_index"
    [ "$supporting_path" = "$expected_path" ] \
      || { printf '%s\n' "invalid supporting evidence path for $event_id: $supporting_path" >&2; return 1; }
    [ -f "$events_root/$supporting_path" ] \
      || { printf '%s\n' "supporting evidence is missing: $supporting_path" >&2; return 1; }
    [ "$(sha256_file "$events_root/$supporting_path")" = "$supporting_digest" ] \
      || { printf '%s\n' "supporting evidence digest does not match: $supporting_path" >&2; return 1; }
    supporting_index=$((supporting_index + 1))
  done

  local event_directory actual_supporting_count
  event_directory="$events_root/events/$event_id"
  actual_supporting_count=$(find "$event_directory" -maxdepth 1 -type f -name 'supporting-*' | wc -l | tr -d ' ')
  [ "$actual_supporting_count" = "$supporting_count" ] \
    || { printf '%s\n' "supporting evidence count does not match for $event_id" >&2; return 1; }
}

validate_format_version() {
  local format_file="$workflow/format-version"
  [ -f "$format_file" ] || { printf '%s\n' 'workflow format version is missing' >&2; return 1; }
  local format_version
  format_version=$(cat "$format_file")
  [ "$format_version" = 2 ] || { printf '%s\n' "workflow format version is unknown: $format_version" >&2; return 1; }
}

reduce_workflow() {
  if ! validate_format_version; then
    printf '%s\n' INVALID
    return 1
  fi
  if ! validate_obligations "$workflow/obligations.tsv"; then
    printf '%s\n' INVALID
    return 1
  fi
  if ! validate_event_chain "$workflow/events.tsv" "$workflow"; then
    printf '%s\n' INVALID
    return 1
  fi

  local blocked_boundaries failed_accept_events final_wave_pending static_reduction
  blocked_boundaries=$(blocked_finding_boundaries | paste -sd, -)
  failed_accept_events=$(failed_accept_event_ids | paste -sd, -)
  final_wave_pending=$(final_wave_is_pending)
  static_reduction=$(awk -F '\t' -v blocked_boundaries="$blocked_boundaries" -v failed_accept_events="$failed_accept_events" -v final_wave_pending="$final_wave_pending" '
    BEGIN {
      boundary_count = split(blocked_boundaries, boundary_list, ",")
      for (boundary_index = 1; boundary_index <= boundary_count; boundary_index++) {
        if (boundary_list[boundary_index] != "") {
          blocked[boundary_list[boundary_index]] = 1
        }
      }
      failed_count = split(failed_accept_events, failed_list, ",")
      for (failed_index = 1; failed_index <= failed_count; failed_index++) {
        if (failed_list[failed_index] != "") {
          failed[failed_list[failed_index]] = 1
        }
      }
    }
    NR == FNR {
      if (FNR == 1) {
        next
      }
      prerequisites[$1] = $4
      ordered[++count] = $1
      next
    }
    FNR == 1 {
      next
    }
    ($5 == "ACCEPT" && !failed[$3]) || $5 == "COMPLETE" {
      completed[$4] = 1
    }
    $5 == "CLAIM" {
      active[$4] = 1
    }
    $5 == "RELEASE" || $5 == "ACCEPT" || $5 == "COMPLETE" {
      delete active[$4]
    }
    $5 == "EvidenceInvalidated" {
      delete completed[$4]
    }
    END {
      for (position = 1; position <= count; position++) {
        identifier = ordered[position]
        if (identifier == "feature-branch-review" && final_wave_pending == "yes") {
          state = "PENDING"
        } else if (blocked[identifier]) {
          state = "PENDING"
        } else if (completed[identifier]) {
          state = "COMPLETE"
        } else if (active[identifier]) {
          state = "CLAIMED"
        } else {
          is_ready = 1
          if (prerequisites[identifier] != "-") {
            dependency_count = split(prerequisites[identifier], dependencies, ",")
            for (dependency_index = 1; dependency_index <= dependency_count; dependency_index++) {
              if (!completed[dependencies[dependency_index]]) {
                is_ready = 0
              }
            }
          }
          state = is_ready ? "READY" : "PENDING"
        }
        print identifier "\t" state
      }
    }
  ' "$workflow/obligations.tsv" "$workflow/events.tsv")

  reduce_finding_obligations "$static_reduction"
  printf '%s\n' "$static_reduction"
}

final_wave_is_pending() {
  finding_event_facts | awk -F '\t' '
    $2 == "FindingDispositionRecorded" && $4 == "REPAIRING" && $13 == "yes" { active[$3] = 1 }
    $2 == "FindingResolved" { delete active[$3] }
    END { for (id in active) { print "yes"; exit } }
  '
}

finding_event_facts() {
  local sequence event_id metadata_file result_kind finding_id finding_state finding_scope finding_origin report_complete repair_round replay_status replay_through affected_slices blocking_boundary replay_full_lifecycle final_wave_id final_wave_findings
  while IFS=$'\t' read -r sequence _revision event_id _obligation_id _kind _actor _receipt _evidence_path _evidence_sha256 _previous_hash _event_hash; do
    [ "$sequence" = sequence ] && continue
    metadata_file="$workflow/events/$event_id/metadata.tsv"
    [ -f "$metadata_file" ] || continue
    result_kind=$(metadata_value "$metadata_file" result-kind)
    finding_id=$(metadata_value "$metadata_file" finding-id)
    [ -n "$finding_id" ] || continue
    finding_state=$(metadata_value "$metadata_file" finding-state)
    finding_scope=$(metadata_value "$metadata_file" finding-scope)
    finding_origin=$(metadata_value "$metadata_file" finding-origin)
    report_complete=$(metadata_value "$metadata_file" report-complete)
    repair_round=$(metadata_value "$metadata_file" repair-round)
    replay_status=$(metadata_value "$metadata_file" replay-status)
    replay_through=$(metadata_value "$metadata_file" replay-through)
    affected_slices=$(metadata_value "$metadata_file" affected-slices)
    blocking_boundary=$(metadata_value "$metadata_file" blocking-boundary)
    replay_full_lifecycle=$(metadata_value "$metadata_file" replay-full-lifecycle)
    final_wave_id=$(metadata_value "$metadata_file" final-wave-id)
    final_wave_findings=$(metadata_value "$metadata_file" final-wave-findings)
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$sequence" "$result_kind" "$finding_id" "$finding_state" "$finding_scope" "$finding_origin" "$report_complete" "$repair_round" "$replay_status" "$replay_through" "$affected_slices" "$blocking_boundary" "$replay_full_lifecycle" "$final_wave_id" "$final_wave_findings"
  done <"$workflow/events.tsv"
}

failed_accept_event_ids() {
  local event_id event_kind metadata_file
  while IFS=$'\t' read -r _sequence _revision event_id _obligation_id event_kind _actor _receipt _evidence_path _evidence_sha256 _previous_hash _event_hash; do
    [ "$event_kind" = ACCEPT ] || continue
    metadata_file="$workflow/events/$event_id/metadata.tsv"
    [ -f "$metadata_file" ] || continue
    [ "$(metadata_value "$metadata_file" result-kind)" = FAIL ] || continue
    printf '%s\n' "$event_id"
  done <"$workflow/events.tsv"
}

blocked_finding_boundaries() {
  finding_event_facts | awk -F '\t' '
    $2 == "FindingReported" { state[$3] = "REPORTED" }
    $2 == "FindingDispositionRecorded" {
      state[$3] = $4
      if ($4 == "BLOCKED") {
        boundary[$3] = $12
      }
    }
    $2 == "FindingResolved" { state[$3] = "RESOLVED" }
    END {
      for (id in state) {
        if (state[id] == "BLOCKED" && boundary[id] != "") {
          print boundary[id]
        }
      }
    }
  '
}

reduce_finding_obligations() {
  local static_reduction=$1
  awk -F '\t' '
    NR == FNR {
      static_state[$1] = $2
      next
    }
    function role_rank(role) {
      if (role == "Cleaner") return 1
      if (role == "Architect") return 2
      if (role == "Security Reviewer") return 3
      if (role == "Hardener") return 4
      if (role == "QA") return 5
      return 0
    }
    function final_wave_is_registered(id, member_count, member_list, member_index, member_id) {
      if ((scope[id] != "feature" && final_wave_findings[id] == "") || replay_full_lifecycle[id] != "yes") return 1
      if (final_wave_id[id] == "" || final_wave_findings[id] == "") return 0
      member_count = split(final_wave_findings[id], member_list, ",")
      for (member_index = 1; member_index <= member_count; member_index++) {
        member_id = member_list[member_index]
        if (final_wave_id[member_id] != final_wave_id[id] || final_wave_findings[member_id] != final_wave_findings[id]) return 0
        if (state[member_id] != "REPAIRING" && state[member_id] != "RESOLVED") return 0
      }
      return member_count > 0
    }
    function replay_is_complete(id, finding_scope, endpoint, affected, full_lifecycle, slice_count, slices, maximum_rank, slice_index, role_index, roles, obligation, member_count, member_index, member_list, member_id, affected_count, affected_index, affected_list, union_seen) {
      split("cleaner architect security hardener qa", roles, " ")
      if (full_lifecycle == "yes" && (finding_scope == "feature" || final_wave_findings[id] != "")) {
        if (!final_wave_is_registered(id)) return 0
        member_count = split(final_wave_findings[id], member_list, ",")
        for (member_index = 1; member_index <= member_count; member_index++) {
          member_id = member_list[member_index]
          affected_count = split(affected_slices[member_id], affected_list, ",")
          for (affected_index = 1; affected_index <= affected_count; affected_index++) {
            if (affected_list[affected_index] != "" && !(affected_list[affected_index] in union_seen)) {
              union_seen[affected_list[affected_index]] = 1
              slices[++slice_count] = affected_list[affected_index]
            }
          }
          delete affected_list
        }
        maximum_rank = 5
      } else if (full_lifecycle == "yes") {
        slice_count = 1
        slices[1] = finding_scope
        maximum_rank = 5
      } else if (finding_scope == "feature") {
        slice_count = split(affected, slices, ",")
        maximum_rank = 5
      } else {
        slice_count = 1
        slices[1] = finding_scope
        maximum_rank = role_rank(endpoint)
      }
      if (slice_count == 0 || maximum_rank == 0) {
        return 0
      }
      for (slice_index = 1; slice_index <= slice_count; slice_index++) {
        for (role_index = 1; role_index <= maximum_rank; role_index++) {
          obligation = "slice-" slices[slice_index] "-" roles[role_index]
          if (static_state[obligation] != "COMPLETE") {
            return 0
          }
        }
        if (full_lifecycle == "yes" && (static_state["slice-" slices[slice_index] "-final-suite"] != "COMPLETE" || static_state["slice-" slices[slice_index] "-verified"] != "COMPLETE")) {
          return 0
        }
      }
      return 1
    }
    {
      result = $2
      id = $3
      if (!(id in seen)) {
        seen[id] = ++count
        ordered[count] = id
      }
      if (result == "FindingReported") {
        state[id] = "REPORTED"
        complete[id] = ($7 == "yes")
        was_incomplete[id] = ($7 != "yes")
        scope[id] = $5
        origin[id] = $6
      } else if (result == "FindingSupplemented") {
        complete[id] = 1
        supplemented[id] = 1
      } else if (result == "FindingDispositionRecorded") {
        state[id] = $4
        if ($4 == "REPAIRING") {
          replay_through[id] = $10
          affected_slices[id] = $11
          replay_full_lifecycle[id] = $13
          final_wave_id[id] = $14
          final_wave_findings[id] = $15
        }
      } else if (result == "RepairStarted") {
        started[id, $8] = 1
        round[id] = $8 + 0
      } else if (result == "RepairFinished") {
        finished[id, $8] = 1
        finish_status[id, $8] = $9
        round[id] = $8 + 0
      } else if (result == "ReplayEntered") {
        replay_entered[id] = 1
      } else if (result == "FindingResolved") {
        state[id] = "RESOLVED"
      } else if (result == "RepairAccepted") {
        repair_accepted[id] = 1
      } else if (result == "FindingsDigestWritten") {
        digest_written = 1
      }
    }
    END {
      for (position = 1; position <= count; position++) {
        id = ordered[position]
        supplement = "finding-" id "-supplement"
        verify = "finding-" id "-verify"
        dispose = "finding-" id "-dispose"
        if (was_incomplete[id]) {
          print supplement "\t" (supplemented[id] ? "COMPLETE" : "READY")
        }
        print verify "\t" (complete[id] ? "COMPLETE" : "PENDING")
        finding_state = state[id]
        if (finding_state == "REPORTED") {
          print dispose "\t" (complete[id] ? "READY" : "PENDING")
        } else {
          print dispose "\tCOMPLETE"
        }
        if (finding_state == "REPAIRING") {
          replay = "finding-" id "-replay-entry"
          wave_registered = final_wave_is_registered(id)
          print replay "\t" (replay_entered[id] ? "COMPLETE" : (wave_registered ? "READY" : "PENDING"))
          current_round = round[id] ? round[id] : 1
          start = "finding-" id "-repair-start-" current_round
          finish = "finding-" id "-repair-finish-" current_round
          print start "\t" (started[id, current_round] ? "COMPLETE" : (replay_entered[id] ? "READY" : "PENDING"))
          repair_result = "finding-" id "-repair-result"
          print repair_result "\t" (repair_accepted[id] ? "COMPLETE" : (started[id, current_round] ? "READY" : "PENDING"))
          if (finished[id, current_round]) {
            print finish "\tCOMPLETE"
            if (finish_status[id, current_round] == "VERIFIED") {
              resolve = "finding-" id "-resolve"
              print resolve "\t" (repair_accepted[id] && replay_is_complete(id, scope[id], replay_through[id], affected_slices[id], replay_full_lifecycle[id]) ? "READY" : "PENDING")
            } else if (current_round < 5) {
              print "finding-" id "-repair-start-" (current_round + 1) "\tREADY"
            }
          } else {
            print finish "\t" (repair_accepted[id] && replay_is_complete(id, scope[id], replay_through[id], affected_slices[id], replay_full_lifecycle[id]) ? "READY" : "PENDING")
          }
        }
        if (finding_state == "DEFERRED" || finding_state == "DISMISSED" || finding_state == "PARKED") {
          print "finding-" id "-digest\t" (digest_written ? "COMPLETE" : "PENDING")
          print "finding-" id "-wake\t" (digest_written ? "READY" : "PENDING")
        } else if (finding_state == "BLOCKED") {
          print "finding-" id "-wake\tBLOCKED"
        }
        if (finding_state == "RESOLVED" && repair_accepted[id]) {
          print "finding-" id "-repair-result\tCOMPLETE"
        }
      }
    }
  ' <(printf '%s\n' "$static_reduction") <(finding_event_facts)
}

selected_ready_obligation() {
  awk -F '\t' '$2 == "READY" { print $1; exit }'
}

select_next() {
  local reduced
  if ! reduced=$(reduce_workflow); then
    printf '%s\n' "$reduced"
    return 1
  fi
  local active_claim
  active_claim=$(active_claim_record) || return 1
  if [ -n "$active_claim" ]; then
    local obligation_id actor receipt revision event_id
    IFS=$'\t' read -r obligation_id actor receipt revision event_id <<<"$active_claim"
    printf 'RESUME_CLAIM\nResume claim: %s\nReceipt: %s\n' "$obligation_id" "$receipt"
    return
  fi
  local ready_obligation
  ready_obligation=$(printf '%s\n' "$reduced" | selected_ready_obligation)
  if [ -n "$ready_obligation" ]; then
    printf 'READY\nReady obligation: %s\n' "$ready_obligation"
    return
  fi
  if printf '%s\n' "$reduced" | awk -F '\t' '$2 == "BLOCKED" { found = 1 } END { exit !found }'; then
    printf '%s\n' 'USER_AUTHORITY_REQUIRED'
    return
  fi
  if printf '%s\n' "$reduced" | awk -F '\t' '$2 != "COMPLETE" { exit 1 }'; then
    printf '%s\n' COMPLETE
    return
  fi
  printf '%s\n' 'USER_AUTHORITY_REQUIRED'
}

print_status() {
  local reduced
  if ! reduced=$(reduce_workflow); then
    printf '%s\n' "$reduced"
    return 1
  fi
  printf '%s\n' 'Workflow status: ACTIVE'

  local active_claim active_obligation_id
  active_claim=$(active_claim_record) || return 1
  if [ -n "$active_claim" ]; then
    IFS=$'\t' read -r active_obligation_id _actor _receipt _revision _event_id <<<"$active_claim"
    printf 'Active claim: %s\n' "$active_obligation_id"
  else
    printf '%s\n' 'Active claim: none'
  fi

  local ready_obligation
  while IFS= read -r ready_obligation; do
    [ -n "$ready_obligation" ] && printf 'Ready obligation: %s\n' "$ready_obligation"
  done < <(printf '%s\n' "$reduced" | awk -F '\t' '$2 == "READY" { print $1 }')

  while IFS=$'\t' read -r finding_obligation finding_status; do
    case "$finding_obligation" in finding-*) printf 'Finding obligation: %s %s\n' "$finding_obligation" "$finding_status" ;; esac
  done <<<"$reduced"

  if printf '%s\n' "$reduced" | grep -qF $'feature-complete\tREADY'; then
    printf '%s\n' 'Completion eligible: yes'
  else
    printf '%s\n' 'Completion eligible: no'
  fi
}

initialize_workflow() {
  [ -f "$finding_policy" ] || fail "finding policy is missing: $finding_policy"
  local workspace_script="$script_dir/gdd-workspace"
  [ -x "$workspace_script" ] || fail "gdd-workspace is missing or not executable: $workspace_script"
  workspace=$("$workspace_script" "$plan") || exit $?
  workflow="$workspace/workflow-v1"

  if [ -e "$workflow" ]; then
    [ -f "$workflow/format-version" ] || fail 'workflow-v1 is incomplete'
    validate_pinned_finding_policy
    recover_existing_workflow
    project_workflow || fail 'workflow projection rebuild failed'
    print_status || fail 'workflow-v1 is invalid'
    return
  fi

  local stage="$workspace/.workflow-v1-stage.$$"
  [ ! -e "$stage" ] || fail "workflow initialization stage already exists: $stage"
  mkdir -p "$stage/events" "$stage/projections" "$stage/rejections" "$stage/recovery"
  printf '%s\n' 2 >"$stage/format-version"
  printf '%s\n' $'input\tsha256' >"$stage/input-digests.tsv"
  printf 'plan.md\t%s\n' "$(sha256_file "$plan")" >>"$stage/input-digests.tsv"
  printf 'tasks.md\t%s\n' "$(sha256_file "$tasks_file")" >>"$stage/input-digests.tsv"
  printf 'finding-policy.md\t%s\n' "$(sha256_file "$finding_policy")" >>"$stage/input-digests.tsv"
  compile_obligations "$stage/obligations.tsv" || { rm -rf "$stage"; return 1; }
  validate_obligations "$stage/obligations.tsv" || { rm -rf "$stage"; return 1; }
  printf '%s\n' $'sequence\trevision\tevent_id\tobligation_id\tkind\tactor\treceipt\tevidence_path\tevidence_sha256\tprevious_hash\tevent_hash' >"$stage/events.tsv"
  mv "$stage" "$workflow"
  cp "$finding_policy" "$workspace/finding-policy.md"
  sha256_file "$workspace/finding-policy.md" >"$workspace/finding-policy.sha256"
  project_workflow || fail 'workflow projection initialization failed'
  print_status || fail 'new workflow-v1 is invalid'
}

validate_pinned_finding_policy() {
  local saved_policy="$workspace/finding-policy.md"
  local saved_digest="$workspace/finding-policy.sha256"
  [ -f "$saved_policy" ] && [ -f "$saved_digest" ] || fail 'finding policy snapshot is incomplete'
  [ "$(sha256_file "$saved_policy")" = "$(tr -d '[:space:]' <"$saved_digest")" ] \
    || fail 'saved finding policy snapshot does not match its recorded digest'
}

require_workflow() {
  local workspace_script="$script_dir/gdd-workspace"
  [ -x "$workspace_script" ] || fail "gdd-workspace is missing or not executable: $workspace_script"
  workspace=$("$workspace_script" "$plan") || exit $?
  workflow="$workspace/workflow-v1"
  [ -d "$workflow" ] || fail "workflow-v1 is not initialized: $workflow"
  [ -f "$workflow/format-version" ] || fail 'workflow-v1 is incomplete'
  validate_pinned_finding_policy
  recover_existing_workflow
}

scalar_value() {
  case "$1" in
    *$'\t'*|*$'\r'*|*$'\n'*) fail 'scalar field values cannot contain tabs, carriage returns, or newlines' ;;
  esac
}

require_evidence_status() {
  local evidence_file=$1
  local required_status=$2
  local evidence_label=$3
  [ -s "$evidence_file" ] || fail "$evidence_label evidence is missing or empty: $evidence_file"
  grep -Eq "^Status:[[:space:]]*${required_status}([[:space:]]|$)" "$evidence_file" \
    || fail "$evidence_label evidence must contain 'Status: $required_status': $evidence_file"
}

require_evidence_status_one_of() {
  local evidence_file=$1
  local evidence_label=$2
  shift 2
  local candidate
  [ -s "$evidence_file" ] || fail "$evidence_label evidence is missing or empty: $evidence_file"
  for candidate in "$@"; do
    if grep -Eq "^Status:[[:space:]]*${candidate}([[:space:]]|$)" "$evidence_file"; then
      return 0
    fi
  done
  fail "$evidence_label evidence must contain one of Status: $(printf '%s | ' "$@" | sed 's/ | $//'): $evidence_file"
}

current_revision() {
  awk -F '\t' 'NR > 1 { revision = $2 } END { print revision }' "$workflow/events.tsv"
}

next_sequence() {
  local revision
  revision=$(current_revision)
  if [ -z "$revision" ]; then
    printf '%s\n' 1
  else
    printf '%s\n' $((revision + 1))
  fi
}

active_claim_record() {
  validate_event_chain "$workflow/events.tsv" "$workflow" || return 1
  awk -F '\t' '
    NR == 1 { next }
    $5 == "CLAIM" { obligation = $4; actor = $6; receipt = $7; revision = $2; event_id = $3 }
    ($5 == "ACCEPT" || $5 == "RELEASE" || $5 == "COMPLETE") && $7 == receipt {
      obligation = actor = receipt = revision = event_id = ""
    }
    END {
      if (receipt != "") {
        print obligation "\t" actor "\t" receipt "\t" revision "\t" event_id
      }
    }
  ' "$workflow/events.tsv"
}

obligation_allowed_result() {
  local obligation_id=$1
  local result_kind=$2
  case "$obligation_id:$result_kind" in
    finding-GDD-F[0-9][0-9][0-9][0-9]-supplement:FindingSupplemented|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-dispose:FindingDispositionRecorded|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-wake:FindingDispositionRecorded|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-resolve:FindingResolved|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-repair-start-[1-5]:RepairStarted|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-repair-finish-[1-5]:RepairFinished|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-replay-entry:ReplayEntered|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-repair-result:RepairAccepted|\
    finding-GDD-F[0-9][0-9][0-9][0-9]-digest:FindingsDigestWritten|\
    feature-findings-digest:FindingsDigestWritten|\
    slice-[1-9]*-qa:SliceVerifiedMacro) return 0 ;;
  esac
  awk -F '\t' -v expected_id="$obligation_id" -v expected_result="$result_kind" '
    NR > 1 && $1 == expected_id {
      count = split($5, allowed, ",")
      for (position = 1; position <= count; position++) {
        if (allowed[position] == expected_result) {
          exit 0
        }
      }
      exit 1
    }
    END { if (NR == 1) exit 1 }
  ' "$workflow/obligations.tsv"
}

receipt_revision_is_current() {
  local receipt=$1
  local claim_revision=$2
  awk -F '\t' -v expected_receipt="$receipt" -v claim_revision="$claim_revision" '
    NR == 1 || $2 <= claim_revision { next }
    $5 != "SIDE" || $7 != expected_receipt { exit 1 }
  ' "$workflow/events.tsv"
}

next_finding_id() {
  local last_number
  last_number=$(finding_event_facts | awk -F '\t' '$2 == "FindingReported" { value = substr($3, 6) + 0; if (value > maximum) maximum = value } END { print maximum + 1 }')
  printf 'GDD-F%04d\n' "$last_number"
}

reported_finding_for_receipt_evidence() {
  local expected_receipt=$1
  local expected_digest=$2
  local expected_scope=$3
  local expected_origin=$4
  local event_id metadata_file
  while IFS=$'\t' read -r _sequence _revision event_id _obligation_id kind _actor receipt _evidence_path evidence_digest _previous_hash _event_hash; do
    [ "$kind" = SIDE ] || continue
    [ "$receipt" = "$expected_receipt" ] || continue
    [ "$evidence_digest" = "$expected_digest" ] || continue
    metadata_file="$workflow/events/$event_id/metadata.tsv"
    [ "$(metadata_value "$metadata_file" result-kind)" = FindingReported ] || continue
    [ "$(metadata_value "$metadata_file" finding-scope)" = "$expected_scope" ] || continue
    [ "$(metadata_value "$metadata_file" finding-origin)" = "$expected_origin" ] || continue
    printf '%s\t%s\n' "$event_id" "$(metadata_value "$metadata_file" finding-id)"
    return
  done <"$workflow/events.tsv"
}

append_result_metadata() {
  local metadata_file=$1
  local result_kind=$2
  local evidence_digest=$3
  local claim_revision=$4
  local actor=$5
  {
    printf 'result-kind\t%s\n' "$result_kind"
    printf 'result-sha256\t%s\n' "$evidence_digest"
    printf 'claim-revision\t%s\n' "$claim_revision"
    printf 'claim-actor\t%s\n' "$actor"
    [ -z "${GDD_FINDING_ID:-}" ] || printf 'finding-id\t%s\n' "$GDD_FINDING_ID"
    [ -z "${GDD_FINDING_SCOPE:-}" ] || printf 'finding-scope\t%s\n' "$GDD_FINDING_SCOPE"
    [ -z "${GDD_FINDING_ORIGIN:-}" ] || printf 'finding-origin\t%s\n' "$GDD_FINDING_ORIGIN"
    [ -z "${GDD_REPORT_COMPLETE:-}" ] || printf 'report-complete\t%s\n' "$GDD_REPORT_COMPLETE"
    [ -z "${GDD_FINDING_STATE:-}" ] || printf 'finding-state\t%s\n' "$GDD_FINDING_STATE"
    [ -z "${GDD_FINDING_EVENT_NAME:-}" ] || printf 'finding-event-name\t%s\n' "$GDD_FINDING_EVENT_NAME"
    [ -z "${GDD_REPAIR_ROUND:-}" ] || printf 'repair-round\t%s\n' "$GDD_REPAIR_ROUND"
    [ -z "${GDD_REPLAY_STATUS:-}" ] || printf 'replay-status\t%s\n' "$GDD_REPLAY_STATUS"
    [ -z "${GDD_TARGET_SLICE:-}" ] || printf 'target-slice\t%s\n' "$GDD_TARGET_SLICE"
    [ -z "${GDD_REPLAY_THROUGH:-}" ] || printf 'replay-through\t%s\n' "$GDD_REPLAY_THROUGH"
    [ -z "${GDD_AFFECTED_SLICES:-}" ] || printf 'affected-slices\t%s\n' "$GDD_AFFECTED_SLICES"
    [ -z "${GDD_REPLAY_FULL_LIFECYCLE:-}" ] || printf 'replay-full-lifecycle\t%s\n' "$GDD_REPLAY_FULL_LIFECYCLE"
    if [ -n "${GDD_FINAL_WAVE_FINDINGS:-}" ]; then
      printf 'final-wave-id\tGDD-W%s\n' "$(sha256_values "$GDD_FINAL_WAVE_FINDINGS")"
      printf 'final-wave-findings\t%s\n' "$GDD_FINAL_WAVE_FINDINGS"
    fi
    [ -z "${GDD_BLOCKING_BOUNDARY:-}" ] || printf 'blocking-boundary\t%s\n' "$GDD_BLOCKING_BOUNDARY"
    [ -z "${GDD_FINDING_RULING:-}" ] || printf 'finding-ruling\t%s\n' "$GDD_FINDING_RULING"
    [ -z "${GDD_COST_IF_WRONG:-}" ] || printf 'cost-if-wrong\t%s\n' "$GDD_COST_IF_WRONG"
    [ -z "${GDD_WAKE_CONDITION:-}" ] || printf 'wake-condition\t%s\n' "$GDD_WAKE_CONDITION"
  } >"$metadata_file"
}

metadata_value() {
  local metadata_file=$1
  local expected_key=$2
  awk -F '\t' -v expected_key="$expected_key" '$1 == expected_key { print $2; exit }' "$metadata_file"
}

accepted_event_for_receipt() {
  local expected_receipt=$1
  awk -F '\t' -v expected_receipt="$expected_receipt" 'NR > 1 && $5 == "ACCEPT" && $7 == expected_receipt { print $3; exit }' "$workflow/events.tsv"
}

released_event_for_receipt() {
  local expected_receipt=$1
  awk -F '\t' -v expected_receipt="$expected_receipt" 'NR > 1 && $5 == "RELEASE" && $7 == expected_receipt { print $3; exit }' "$workflow/events.tsv"
}

replay_obligations_for_repair() {
  local obligation_id=$1
  local scope=${obligation_id%-*}
  local replay_roles=''
  case "$obligation_id" in
    slice-[1-9]*-cleaner) replay_roles='cleaner' ;;
    slice-[1-9]*-architect) replay_roles='cleaner architect' ;;
    slice-[1-9]*-security) replay_roles='cleaner architect security' ;;
    slice-[1-9]*-hardener) replay_roles='cleaner architect security hardener' ;;
    slice-[1-9]*-qa) replay_roles='cleaner architect security hardener qa' ;;
    *) return ;;
  esac
  local replay_role
  for replay_role in $replay_roles; do
    printf '%s-%s\n' "$scope" "$replay_role"
  done
}

replay_roles_through() {
  case "$1" in
    Cleaner) printf '%s\n' cleaner ;;
    Architect) printf '%s\n' cleaner architect ;;
    'Security Reviewer') printf '%s\n' cleaner architect security ;;
    Hardener) printf '%s\n' cleaner architect security hardener ;;
    QA) printf '%s\n' cleaner architect security hardener qa ;;
    *) return 1 ;;
  esac
}

event_path_for_id() {
  local event_id=$1
  awk -F '\t' -v expected_id="$event_id" 'NR > 1 && $3 == expected_id { print $8; exit }' "$workflow/events.tsv"
}

acquire_workflow_lock() {
  local lock="$workflow/.lock"
  if mkdir "$lock" 2>/dev/null; then
    printf '%s\n' "$$" >"$lock/pid"
    local process_start
    if process_start=$(ps -o lstart= -p "$$" 2>/dev/null); then
      printf '%s\n' "${process_start#"${process_start%%[! ]*}"}" >"$lock/process-start"
    else
      printf '%s\n' unavailable >"$lock/process-start"
    fi
    return
  fi

  local owner_pid=''
  [ -f "$lock/pid" ] && owner_pid=$(cat "$lock/pid")
  if [ -n "$owner_pid" ] && kill -0 "$owner_pid" 2>/dev/null; then
    local recorded_start current_start
    recorded_start=$(cat "$lock/process-start" 2>/dev/null || true)
    current_start=$(ps -o lstart= -p "$owner_pid" 2>/dev/null || true)
    if [ "$recorded_start" = unavailable ] || [ -z "$recorded_start" ] || [ "$recorded_start" = "${current_start#"${current_start%%[! ]*}"}" ]; then
      fail 'workflow is busy with one active action'
    fi
  fi
  mkdir -p "$workflow/recovery"
  mv "$lock" "$workflow/recovery/lock-${owner_pid:-unknown}-$$"
  acquire_workflow_lock
}

release_workflow_lock() {
  # The lock only protects this process's published journal transaction.
  rm -rf "$workflow/.lock"
}

event_directories_match() {
  local source_directory=$1
  local destination_directory=$2
  [ -d "$destination_directory" ] || return 1
  local source_file relative_path destination_file
  while IFS= read -r source_file; do
    relative_path=${source_file#"$source_directory/"}
    destination_file="$destination_directory/$relative_path"
    [ -f "$destination_file" ] || return 1
    [ "$(sha256_file "$source_file")" = "$(sha256_file "$destination_file")" ] || return 1
  done < <(find "$source_directory" -type f -print)
  [ "$(find "$source_directory" -type f | wc -l | tr -d ' ')" = "$(find "$destination_directory" -type f | wc -l | tr -d ' ')" ]
}

publish_event_directory() {
  local source_directory=$1
  local destination_directory=$2
  if event_directories_match "$source_directory" "$destination_directory"; then
    return
  fi
  local replacement_directory="$workflow/events/.recovery-$(basename "$source_directory")-$$"
  # A replacement copy remains outside the visible evidence path until every file verifies.
  rm -rf "$replacement_directory"
  cp -R "$source_directory" "$replacement_directory"
  event_directories_match "$source_directory" "$replacement_directory" || return 1
  # An incomplete destination cannot accompany a published journal.
  rm -rf "$destination_directory"
  mv "$replacement_directory" "$destination_directory"
  event_directories_match "$source_directory" "$destination_directory"
}

recover_transactions() {
  local stage
  for stage in "$workflow"/.stage.*; do
    [ -d "$stage" ] || continue
    local manifest="$stage/transaction-manifest.tsv"
    if [ ! -f "$manifest" ]; then
      mkdir -p "$workflow/recovery"
      # Preserve an incomplete stage for audit instead of deleting unverified evidence.
      mv "$stage" "$workflow/recovery/rejected-stage-$(basename "$stage")"
      continue
    fi

    local valid=1 relative_path expected_digest
    while IFS=$'\t' read -r relative_path expected_digest; do
      [ "$relative_path" = path ] && continue
      if [ ! -f "$stage/$relative_path" ] || [ "$(sha256_file "$stage/$relative_path")" != "$expected_digest" ]; then
        valid=0
        break
      fi
    done <"$manifest"
    if [ "$valid" -ne 1 ]; then
      mkdir -p "$workflow/recovery"
      # Preserve a digest-mismatched stage because it cannot safely publish.
      mv "$stage" "$workflow/recovery/rejected-stage-$(basename "$stage")"
      continue
    fi

    local staged_event_directory published_directory
    for staged_event_directory in "$stage"/events/*; do
      [ -d "$staged_event_directory" ] || continue
      published_directory="$workflow/events/$(basename "$staged_event_directory")"
      publish_event_directory "$staged_event_directory" "$published_directory" || valid=0
    done
    if [ "$valid" -ne 1 ]; then
      mkdir -p "$workflow/recovery"
      # Preserve a stage whose evidence could not be fully repaired before journal publication.
      mv "$stage" "$workflow/recovery/rejected-stage-$(basename "$stage")"
      continue
    fi
    if ! validate_event_chain "$stage/events.tsv" "$workflow"; then
      mkdir -p "$workflow/recovery"
      mv "$stage" "$workflow/recovery/rejected-stage-$(basename "$stage")"
      continue
    fi
    if ! cmp -s "$stage/events.tsv" "$workflow/events.tsv"; then
      mv "$stage/events.tsv" "$workflow/events.tsv"
    fi
    rm -f "$manifest"
    # The published journal and evidence make this verified stage disposable.
    rm -rf "$stage"
  done
}

run_locked() {
  acquire_workflow_lock
  recover_transactions
  local command_status=0
  if "$@"; then
    command_status=0
  else
    command_status=$?
  fi
  release_workflow_lock
  return "$command_status"
}

recover_existing_workflow() {
  run_locked :
}

stage_event() {
  local stage=$1
  local sequence=$2
  local obligation_id=$3
  local kind=$4
  local actor=$5
  local receipt=$6
  local evidence_file=$7
  local evidence_name=$8
  local metadata_file=$9
  shift 9
  local event_id="event-$sequence"
  local evidence_path="events/$event_id/$evidence_name"
  mkdir -p "$stage/events/$event_id"
  cp "$evidence_file" "$stage/$evidence_path"
  cp "$metadata_file" "$stage/events/$event_id/metadata.tsv"
  local supporting_file supporting_index=1 supporting_path
  for supporting_file in "$@"; do
    [ -f "$supporting_file" ] || fail "supporting evidence is missing: $supporting_file"
    supporting_path="events/$event_id/supporting-$supporting_index"
    cp "$supporting_file" "$stage/$supporting_path"
    printf 'supporting-evidence-%s-path\t%s\n' "$supporting_index" "$supporting_path" >>"$stage/events/$event_id/metadata.tsv"
    printf 'supporting-evidence-%s-sha256\t%s\n' "$supporting_index" "$(sha256_file "$stage/$supporting_path")" >>"$stage/events/$event_id/metadata.tsv"
    supporting_index=$((supporting_index + 1))
  done
  printf 'supporting-evidence-count\t%s\n' "$((supporting_index - 1))" >>"$stage/events/$event_id/metadata.tsv"
  local evidence_digest metadata_digest previous_hash event_hash
  evidence_digest=$(sha256_file "$stage/$evidence_path")
  metadata_digest=$(sha256_file "$stage/events/$event_id/metadata.tsv")
  previous_hash=$(awk -F '\t' 'NR > 1 { event_hash = $11 } END { print event_hash }' "$stage/events.tsv")
  [ -n "$previous_hash" ] || previous_hash='-'
  event_hash=$(sha256_values "$sequence" "$sequence" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_digest" "$previous_hash" "$metadata_digest")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$sequence" "$sequence" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_digest" "$previous_hash" "$event_hash" \
    >>"$stage/events.tsv"
  printf '%s\n' "$event_id"
}

write_staged_manifest() {
  local stage=$1
  {
    printf '%s\n' $'path\tsha256'
    find "$stage/events" -type f -print | while IFS= read -r staged_file; do
      local relative_path=${staged_file#"$stage/"}
      printf '%s\t%s\n' "$relative_path" "$(sha256_file "$staged_file")"
    done
    printf 'events.tsv\t%s\n' "$(sha256_file "$stage/events.tsv")"
  } >"$stage/transaction-manifest.tsv"
}

publish_staged_transaction() {
  local stage=$1
  local staged_event_directory published_directory published_count=0
  for staged_event_directory in "$stage"/events/*; do
    published_directory="$workflow/events/$(basename "$staged_event_directory")"
    if [ "${GDD_WORKFLOW_TEST_INTERRUPT_DURING_EVIDENCE_PUBLICATION:-}" = 1 ] && [ "$published_count" -eq 1 ]; then
      mkdir -p "$published_directory"
      cp "$staged_event_directory/metadata.tsv" "$published_directory/metadata.tsv"
      return 76
    fi
    publish_event_directory "$staged_event_directory" "$published_directory" || return 1
    published_count=$((published_count + 1))
  done
  if [ "${GDD_WORKFLOW_TEST_INTERRUPT_AFTER_EVIDENCE:-}" = 1 ]; then
    return 75
  fi
  validate_event_chain "$stage/events.tsv" "$workflow" || return 1
  mv "$stage/events.tsv" "$workflow/events.tsv"
  rm -f "$stage/transaction-manifest.tsv"
  # The journal now references every evidence directory in this transaction.
  rm -rf "$stage"
}

append_staged_event() {
  local obligation_id=$1
  local kind=$2
  local actor=$3
  local receipt=$4
  local evidence_file=$5
  local evidence_name=$6
  local metadata_file=$7
  shift 7
  local stage="$workflow/.stage.$$"
  [ ! -e "$stage" ] || fail "workflow transaction stage already exists: $stage"
  mkdir -p "$stage/events"
  cp "$workflow/events.tsv" "$stage/events.tsv"
  local event_id
  event_id=$(stage_event "$stage" "$(next_sequence)" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_file" "$evidence_name" "$metadata_file" "$@") || return 75
  write_staged_manifest "$stage"
  publish_staged_transaction "$stage" || return $?
  printf '%s\n' "$event_id"
}

final_wave_registration_completes() {
  local candidate_metadata=$1
  local candidate_id final_wave_id final_wave_findings old_ifs member_id
  candidate_id=$(metadata_value "$candidate_metadata" finding-id)
  final_wave_id=$(metadata_value "$candidate_metadata" final-wave-id)
  final_wave_findings=$(metadata_value "$candidate_metadata" final-wave-findings)
  [ -n "$final_wave_id" ] && [ -n "$final_wave_findings" ] || return 1
  old_ifs=$IFS
  IFS=','
  set -- $final_wave_findings
  IFS=$old_ifs
  for member_id in "$@"; do
    [ "$member_id" = "$candidate_id" ] && continue
    finding_event_facts | awk -F '\t' -v expected_id="$member_id" -v expected_wave="$final_wave_id" '
      $2 == "FindingDispositionRecorded" && $3 == expected_id && $4 == "REPAIRING" && $14 == expected_wave { found=1 }
      END { exit !found }
    ' || return 1
  done
}

append_repair_acceptance_group() {
  local obligation_id=$1
  local actor=$2
  local receipt=$3
  local evidence_file=$4
  local metadata_file=$5
  shift 5
  local stage="$workflow/.stage.$$"
  [ ! -e "$stage" ] || fail "workflow transaction stage already exists: $stage"
  mkdir -p "$stage/events"
  cp "$workflow/events.tsv" "$stage/events.tsv"
  local sequence accepted_event_id
  sequence=$(next_sequence)
  accepted_event_id=$(stage_event "$stage" "$sequence" "$obligation_id" ACCEPT "$actor" "$receipt" "$evidence_file" result "$metadata_file" "$@") || return 75

  local result_kind finding_state finding_scope replay_through affected_slices replay_full_lifecycle final_wave_findings
  result_kind=$(metadata_value "$metadata_file" result-kind)
  finding_state=$(metadata_value "$metadata_file" finding-state)
  finding_scope=$(metadata_value "$metadata_file" finding-scope)
  replay_through=$(metadata_value "$metadata_file" replay-through)
  affected_slices=$(metadata_value "$metadata_file" affected-slices)
  replay_full_lifecycle=$(metadata_value "$metadata_file" replay-full-lifecycle)
  final_wave_findings=$(metadata_value "$metadata_file" final-wave-findings)

  if [ "$result_kind" = FindingDispositionRecorded ] && [ "$finding_state" = REPAIRING ]; then
    local replay_roles replay_role affected_slice invalidation_metadata
    if [ "$replay_full_lifecycle" = yes ]; then
      replay_roles='cleaner architect security hardener qa final-suite verified'
    elif [ "$finding_scope" = feature ]; then
      replay_roles='cleaner architect security hardener qa'
    else
      replay_roles=$(replay_roles_through "$replay_through") || return 75
      affected_slices=$finding_scope
    fi
    local old_ifs=$IFS
    IFS=','
    set -- $affected_slices
    IFS=$old_ifs
    for affected_slice in "$@"; do
      for replay_role in $replay_roles; do
        sequence=$((sequence + 1))
        invalidation_metadata=$(mktemp)
        {
          printf 'accepted-event-id\t%s\n' "$accepted_event_id"
          printf 'invalidated-obligation\tslice-%s-%s\n' "$affected_slice" "$replay_role"
        } >"$invalidation_metadata"
        stage_event "$stage" "$sequence" "slice-$affected_slice-$replay_role" EvidenceInvalidated "$actor" "$receipt" "$evidence_file" invalidation "$invalidation_metadata" >/dev/null || {
          rm -f "$invalidation_metadata"
          return 75
        }
        rm -f "$invalidation_metadata"
      done
    done
    if [ "$replay_full_lifecycle" = yes ] && { { [ "$finding_scope" != feature ] && [ -z "$final_wave_findings" ]; } || final_wave_registration_completes "$metadata_file"; }; then
      sequence=$((sequence + 1))
      invalidation_metadata=$(mktemp)
      {
        printf 'accepted-event-id\t%s\n' "$accepted_event_id"
        printf 'invalidated-obligation\tfeature-branch-review\n'
      } >"$invalidation_metadata"
      stage_event "$stage" "$sequence" feature-branch-review EvidenceInvalidated "$actor" "$receipt" "$evidence_file" invalidation "$invalidation_metadata" >/dev/null || {
        rm -f "$invalidation_metadata"
        return 75
      }
      rm -f "$invalidation_metadata"
    fi
  fi

  case "$actor" in
    fixer|fixer-max)
      local replay_obligation invalidation_metadata
      while IFS= read -r replay_obligation; do
        [ -n "$replay_obligation" ] || continue
        sequence=$((sequence + 1))
        invalidation_metadata=$(mktemp)
        {
          printf 'accepted-event-id\t%s\n' "$accepted_event_id"
          printf 'invalidated-obligation\t%s\n' "$replay_obligation"
        } >"$invalidation_metadata"
        stage_event "$stage" "$sequence" "$replay_obligation" EvidenceInvalidated "$actor" "$receipt" "$evidence_file" invalidation "$invalidation_metadata" >/dev/null || {
          rm -f "$invalidation_metadata"
          return 75
        }
        rm -f "$invalidation_metadata"
      done < <(replay_obligations_for_repair "$obligation_id")
      ;;
  esac

  write_staged_manifest "$stage"
  publish_staged_transaction "$stage" || return $?
  printf '%s\n' "$accepted_event_id"
}

claim_action() {
  local obligation_id=$1
  local actor=$2
  local dispatch_file=$3
  [ -f "$dispatch_file" ] || fail "dispatch evidence is missing: $dispatch_file"
  scalar_value "$obligation_id"
  scalar_value "$actor"
  local reduced ready_obligation requested_state active_claim
  reduced=$(reduce_workflow) || fail 'workflow-v1 is invalid'
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -z "$active_claim" ] || fail 'one action is already claimed'
  ready_obligation=$(printf '%s\n' "$reduced" | selected_ready_obligation)
  requested_state=$(printf '%s\n' "$reduced" | awk -F '\t' -v expected="$obligation_id" '$1 == expected { print $2; exit }')
  case "$obligation_id:$requested_state" in
    finding-GDD-F[0-9][0-9][0-9][0-9]-wake:PENDING)
      # The controller checks a parked finding's recorded wake condition before
      # issuing dependent work. Wake evidence remains validated by the existing
      # finding transition before this claim can be accepted.
      ;;
    *:BLOCKED)
      case "$obligation_id" in finding-GDD-F[0-9][0-9][0-9][0-9]-wake) ;; *) fail "obligation is blocked: $obligation_id" ;; esac
      ;;
    *)
    [ "$obligation_id" = "$ready_obligation" ] || fail "obligation is not the selected ready action: $obligation_id"
      ;;
  esac

  local sequence nonce_basename dispatch_digest receipt_file receipt_digest metadata_file event_id
  sequence=$(next_sequence)
  nonce_basename="nonce-$$_$RANDOM"
  dispatch_digest=$(sha256_file "$dispatch_file")
  receipt_file=$(mktemp)
  {
    printf '%s\n' 'workflow-format: 2'
    printf 'obligation-id: %s\n' "$obligation_id"
    printf 'claim-revision: %s\n' "$sequence"
    printf 'actor: %s\n' "$actor"
    printf 'dispatch-sha256: %s\n' "$dispatch_digest"
    printf 'nonce-path: %s\n' "$nonce_basename"
  } >"$receipt_file"
  receipt_digest=$(sha256_file "$receipt_file")
  metadata_file=$(mktemp)
  {
    printf 'claim-revision\t%s\n' "$sequence"
    printf 'dispatch-sha256\t%s\n' "$dispatch_digest"
    printf 'nonce-path\t%s\n' "$nonce_basename"
    printf 'receipt-sha256\t%s\n' "$receipt_digest"
  } >"$metadata_file"
  event_id=$(append_staged_event "$obligation_id" CLAIM "$actor" "GDD-R$receipt_digest" "$dispatch_file" dispatch "$metadata_file" "$receipt_file") || {
    rm -f "$receipt_file" "$metadata_file"
    return 75
  }
  rm -f "$receipt_file" "$metadata_file"
  printf 'Event ID: %s\nReceipt: GDD-R%s\n' "$event_id" "$receipt_digest"
}

accept_action() {
  local receipt=$1
  local result_kind=$2
  local evidence_file=$3
  shift 3
  [ -f "$evidence_file" ] || fail "result evidence is missing: $evidence_file"
  scalar_value "$receipt"
  scalar_value "$result_kind"
  local accepted_event_id evidence_digest existing_path metadata_file existing_result_kind existing_digest
  evidence_digest=$(sha256_file "$evidence_file")
  accepted_event_id=$(accepted_event_for_receipt "$receipt")
  if [ -n "$accepted_event_id" ]; then
    existing_path=$(event_path_for_id "$accepted_event_id")
    metadata_file="$workflow/$(dirname "$existing_path")/metadata.tsv"
    existing_result_kind=$(metadata_value "$metadata_file" result-kind)
    existing_digest=$(metadata_value "$metadata_file" result-sha256)
    if [ "$existing_result_kind" = "$result_kind" ] && [ "$existing_digest" = "$evidence_digest" ]; then
      printf 'Event ID: %s\n' "$accepted_event_id"
      return
    fi
    local rejection_digest
    rejection_digest=$(sha256_values "$receipt" "$result_kind" "$evidence_digest")
    cp "$evidence_file" "$workflow/rejections/rejection-$rejection_digest"
    printf 'Accepted event ID: %s\n' "$accepted_event_id" >&2
    return 1
  fi

  local active_claim obligation_id actor active_receipt claim_revision event_id metadata_temp
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -n "$active_claim" ] || fail 'receipt does not match the active claim'
  IFS=$'\t' read -r obligation_id actor active_receipt claim_revision event_id <<<"$active_claim"
  [ "$receipt" = "$active_receipt" ] || fail 'receipt does not match the active claim'
  # Only a completed implementer report may unlock the review obligation.
  case "$obligation_id:$result_kind" in
    slice-*-implementer:PASS)
      require_evidence_status_one_of "$evidence_file" Implementer DONE DONE_WITH_CONCERNS
      ;;
  esac
  if finding_origin_for_obligation "$obligation_id" >/dev/null; then
    fail 'lifecycle role result requires grouped finding acceptance via accept-active'
  fi
  obligation_allowed_result "$obligation_id" "$result_kind" || fail "result kind $result_kind is not allowed for $obligation_id"
  receipt_revision_is_current "$receipt" "$claim_revision" || fail 'receipt claim revision is stale'
  metadata_temp=$(mktemp)
  append_result_metadata "$metadata_temp" "$result_kind" "$evidence_digest" "$claim_revision" "$actor"
  local append_status=0
  event_id=$(append_repair_acceptance_group "$obligation_id" "$actor" "$receipt" "$evidence_file" "$metadata_temp" "$@") || append_status=$?
  if [ "$append_status" -ne 0 ]; then
    rm -f "$metadata_temp"
    return "$append_status"
  fi
  rm -f "$metadata_temp"
  printf 'Event ID: %s\n' "$event_id"
}

append_verified_group() {
  local obligation_id=$1
  local actor=$2
  local receipt=$3
  local qa_file=$4
  local final_suite_file=$5
  local finding_scope=$6
  local finding_origin=$7
  local stage="$workflow/.stage.$$"
  [ ! -e "$stage" ] || fail "workflow transaction stage already exists: $stage"
  mkdir -p "$stage/events"
  cp "$workflow/events.tsv" "$stage/events.tsv"
  local sequence metadata_temp event_id final_suite_obligation verified_obligation
  sequence=$(next_sequence)
  metadata_temp=$(mktemp)
  append_result_metadata "$metadata_temp" PASS "$(sha256_file "$qa_file")" "$sequence" "$actor"
  event_id=$(stage_event "$stage" "$sequence" "$obligation_id" ACCEPT "$actor" "$receipt" "$qa_file" result "$metadata_temp") || return 75
  local finding_file finding_id finding_number
  if [ "$role_finding_count" -gt 0 ]; then
    for finding_number in $(seq 1 "$role_finding_count"); do
      finding_file="$GDD_FINDINGS_DIR/$finding_number.md"
      finding_id=$(printf 'GDD-F%04d' "$(( $(next_finding_id | sed 's/GDD-F//') + finding_number - 1 ))")
      sequence=$((sequence + 1))
      {
        printf 'result-kind\tFindingReported\n'
        printf 'result-sha256\t%s\n' "$(sha256_file "$finding_file")"
        printf 'claim-revision\t%s\n' "$sequence"
        printf 'claim-actor\t%s\n' "$actor"
        printf 'finding-id\t%s\n' "$finding_id"
        printf 'finding-scope\t%s\n' "$finding_scope"
        printf 'finding-origin\t%s\n' "$(finding_file_origin "$finding_file")"
        printf 'report-complete\tyes\n'
        printf 'finding-state\tREPORTED\n'
        printf 'finding-event-name\treport\n'
      } >"$metadata_temp"
      stage_event "$stage" "$sequence" "$obligation_id" SIDE "$actor" "$receipt" "$finding_file" "finding-$finding_number" "$metadata_temp" >/dev/null || return 75
    done
  fi
  final_suite_obligation=${obligation_id%-qa}-final-suite
  verified_obligation=${obligation_id%-qa}-verified
  sequence=$((sequence + 1))
  append_result_metadata "$metadata_temp" PASS "$(sha256_file "$final_suite_file")" "$sequence" "$actor"
  stage_event "$stage" "$sequence" "$final_suite_obligation" ACCEPT "$actor" "$receipt" "$final_suite_file" result "$metadata_temp" >/dev/null || return 75
  sequence=$((sequence + 1))
  append_result_metadata "$metadata_temp" PASS "$(sha256_file "$final_suite_file")" "$sequence" "$actor"
  stage_event "$stage" "$sequence" "$verified_obligation" ACCEPT "$actor" "$receipt" "$final_suite_file" result "$metadata_temp" >/dev/null || return 75
  rm -f "$metadata_temp"
  write_staged_manifest "$stage"
  publish_staged_transaction "$stage" || return $?
  printf '%s\n' "$event_id"
}

finding_origin_for_obligation() {
  case "$1" in
    slice-*-review) printf '%s\n' 'Task Reviewer' ;;
    slice-*-cleaner) printf '%s\n' Cleaner ;;
    slice-*-architect) printf '%s\n' Architect ;;
    slice-*-hardener) printf '%s\n' Hardener ;;
    slice-*-qa) printf '%s\n' QA ;;
    feature-branch-review) printf '%s\n' 'Branch Reviewer' ;;
    feature-security-review) printf '%s\n' 'Security Reviewer' ;;
    *) return 1 ;;
  esac
}

finding_file_origin() {
  awk -F ': ' '/^Origin role:/ { print $2; exit }' "$1"
}

finding_origin_is_authorized() {
  local obligation_id=$1
  local origin=$2
  case "$obligation_id" in
    slice-*-review)
      case "$origin" in 'Task Reviewer'|Re-reviewer) return 0 ;; esac
      return 1
      ;;
  esac
  [ "$origin" = "$(finding_origin_for_obligation "$obligation_id")" ]
}

role_finding_count=0

finding_count_from_role_report() {
  local role_report=$1
  local finding_count
  finding_count=$(sed -n 's/^Finding count: \([0-9][0-9]*\)$/\1/p' "$role_report")
  [ "$(printf '%s\n' "$finding_count" | awk 'NF { count++ } END { print count + 0 }')" -eq 1 ] \
    || fail 'role report must contain exactly one Finding count: N'
  printf '%s\n' "$finding_count"
}

validate_role_findings() {
  local obligation_id=$1
  local finding_count=$2
  local findings_dir=$3
  local authorized_origin finding_number finding_file actual_count normalized_number
  local seen_finding_numbers='' noncanonical_finding_file=no

  case "$finding_count" in ''|*[!0-9]*) fail 'Finding count must be a non-negative integer' ;; esac
  [ -d "$findings_dir" ] || fail 'FINDINGS_DIR is missing'
  authorized_origin=$(finding_origin_for_obligation "$obligation_id") \
    || fail "active obligation $obligation_id cannot authorize a finding report"
  case "$obligation_id" in slice-*-review) authorized_origin='Task Reviewer or Re-reviewer' ;; esac
  actual_count=$(find "$findings_dir" -maxdepth 1 -type f | wc -l | tr -d ' ')
  [ "$actual_count" -eq "$finding_count" ] \
    || fail 'finding count does not match numbered finding files'
  for finding_file in "$findings_dir"/*; do
    [ -e "$finding_file" ] || continue
    [ -f "$finding_file" ] || fail 'unexpected finding file'
    case "$(basename "$finding_file")" in
      *.md)
        finding_number=${finding_file##*/}
        finding_number=${finding_number%.md}
        case "$finding_number" in *[!0-9]*|'') fail 'unexpected finding file' ;; esac
        normalized_number=$((10#$finding_number))
        [ "$normalized_number" -ge 1 ] && [ "$normalized_number" -le "$finding_count" ] \
          || fail 'unexpected finding file'
        case " $seen_finding_numbers " in
          *" $normalized_number "*) fail 'duplicate finding number' ;;
        esac
        seen_finding_numbers="$seen_finding_numbers $normalized_number"
        [ "$(basename "$finding_file")" = "$normalized_number.md" ] \
          || noncanonical_finding_file=yes
        ;;
      *) fail 'unexpected finding file' ;;
    esac
  done
  [ "$noncanonical_finding_file" = no ] || fail 'unexpected finding file'
  role_finding_count=$finding_count
  if [ "$finding_count" -gt 0 ]; then
    for finding_number in $(seq 1 "$finding_count"); do
      finding_file="$findings_dir/$finding_number.md"
      [ -f "$finding_file" ] || fail 'finding count does not match numbered finding files'
      local field
      for field in \
        'Origin role:' 'Severity claim:' 'Blocking claim:' 'Observed failure:' 'Evidence:' \
        'Violated authority:' 'Assumptions:' 'Failure scenario:' 'Proposed repair:' 'Repair effects:'; do
        grep -Eq "^${field} .+" "$finding_file" \
          || fail "finding file is missing required field: $field"
      done
      finding_origin_is_authorized "$obligation_id" "$(finding_file_origin "$finding_file")" \
        || fail "finding origin differs from claimed role: $authorized_origin"
    done
  fi
}

append_role_result_group() {
  local obligation_id=$1
  local actor=$2
  local receipt=$3
  local evidence_file=$4
  local result_kind=$5
  local claim_revision=$6
  local finding_scope=$7
  local finding_origin=$8
  local stage="$workflow/.stage.$$"
  [ ! -e "$stage" ] || fail "workflow transaction stage already exists: $stage"
  mkdir -p "$stage/events"
  cp "$workflow/events.tsv" "$stage/events.tsv"

  local sequence metadata_file event_id finding_file finding_id finding_number
  sequence=$(next_sequence)
  metadata_file=$(mktemp)
  append_result_metadata "$metadata_file" "$result_kind" "$(sha256_file "$evidence_file")" "$claim_revision" "$actor"
  event_id=$(stage_event "$stage" "$sequence" "$obligation_id" ACCEPT "$actor" "$receipt" "$evidence_file" result "$metadata_file") || return 75
  rm -f "$metadata_file"

  if [ "$role_finding_count" -gt 0 ]; then
    for finding_number in $(seq 1 "$role_finding_count"); do
      finding_file="$GDD_FINDINGS_DIR/$finding_number.md"
      finding_id=$(printf 'GDD-F%04d' "$(( $(next_finding_id | sed 's/GDD-F//') + finding_number - 1 ))")
      sequence=$((sequence + 1))
      metadata_file=$(mktemp)
      {
        printf 'result-kind\tFindingReported\n'
        printf 'result-sha256\t%s\n' "$(sha256_file "$finding_file")"
        printf 'claim-revision\t%s\n' "$claim_revision"
        printf 'claim-actor\t%s\n' "$actor"
        printf 'finding-id\t%s\n' "$finding_id"
        printf 'finding-scope\t%s\n' "$finding_scope"
        printf 'finding-origin\t%s\n' "$(finding_file_origin "$finding_file")"
        printf 'report-complete\tyes\n'
        printf 'finding-state\tREPORTED\n'
        printf 'finding-event-name\treport\n'
      } >"$metadata_file"
      stage_event "$stage" "$sequence" "$obligation_id" SIDE "$actor" "$receipt" "$finding_file" "finding-$finding_number" "$metadata_file" >/dev/null || return 75
      rm -f "$metadata_file"
    done
  fi
  case "$actor" in
    fixer|fixer-max)
      local replay_obligation invalidation_metadata
      while IFS= read -r replay_obligation; do
        [ -n "$replay_obligation" ] || continue
        sequence=$((sequence + 1))
        invalidation_metadata=$(mktemp)
        {
          printf 'accepted-event-id\t%s\n' "$event_id"
          printf 'invalidated-obligation\t%s\n' "$replay_obligation"
        } >"$invalidation_metadata"
        stage_event "$stage" "$sequence" "$replay_obligation" EvidenceInvalidated "$actor" "$receipt" "$evidence_file" invalidation "$invalidation_metadata" >/dev/null || {
          rm -f "$invalidation_metadata"
          return 75
        }
        rm -f "$invalidation_metadata"
      done < <(replay_obligations_for_repair "$obligation_id")
      ;;
  esac
  write_staged_manifest "$stage"
  publish_staged_transaction "$stage" || return $?
  printf '%s\n' "$event_id"
}

accept_active_action() {
  local expected_obligation=$1
  local result_kind=$2
  local evidence_file=$3
  shift 3
  [ -f "$evidence_file" ] || fail "result evidence is missing: $evidence_file"
  local active_claim obligation_id actor receipt claim_revision claim_event_id
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -n "$active_claim" ] || fail 'no active claim authorizes this result'
  IFS=$'\t' read -r obligation_id actor receipt claim_revision claim_event_id <<<"$active_claim"
  [ "$obligation_id" = "$expected_obligation" ] || fail "active claim is $obligation_id, not $expected_obligation"

  local grouped_origin=''
  if grouped_origin=$(finding_origin_for_obligation "$obligation_id"); then
    [ "$result_kind" != FindingReported ] \
      || fail 'lifecycle findings must use grouped role acceptance'
    [ -n "${GDD_FINDINGS_DIR:-}" ] \
      || fail 'lifecycle role result requires grouped finding evidence'
    case "$obligation_id" in
      slice-*-hardener)
        case "$result_kind" in
          PASS) require_evidence_status "$evidence_file" VERIFIED Hardener ;;
          FAIL) require_evidence_status_one_of "$evidence_file" Hardener 'NOT VERIFIED' REVERIFY_REQUIRED ;;
          *) fail 'Hardener lifecycle results must be PASS or FAIL' ;;
        esac
        ;;
      slice-*-qa)
        case "$result_kind" in
          SliceVerifiedMacro)
            [ $# -eq 1 ] || fail 'SliceVerifiedMacro requires one final-suite evidence file'
            require_evidence_status "$evidence_file" VERIFIED QA
            require_evidence_status "$1" PASS 'Final slice suite'
            ;;
          FAIL)
            [ $# -eq 0 ] || fail 'QA NOT VERIFIED result must not include final-suite evidence'
            require_evidence_status "$evidence_file" 'NOT VERIFIED' QA
            ;;
          *) fail 'QA lifecycle results must use SliceVerifiedMacro or FAIL' ;;
        esac
        ;;
    esac
    local grouped_origin grouped_scope grouped_event_id
    case "$obligation_id" in
      slice-*-*)
        grouped_scope=${obligation_id#slice-}
        grouped_scope=${grouped_scope%%-*}
        ;;
      feature-branch-review|feature-security-review) grouped_scope=feature ;;
    esac
    local grouped_count
    grouped_count=$(finding_count_from_role_report "$evidence_file")
    validate_role_findings "$obligation_id" "$grouped_count" "$GDD_FINDINGS_DIR"
    obligation_allowed_result "$obligation_id" "$result_kind" \
      || fail "result kind $result_kind is not allowed for $obligation_id"
    if [ "$result_kind" = SliceVerifiedMacro ]; then
      [ $# -eq 1 ] || fail 'SliceVerifiedMacro requires one final-suite evidence file'
      grouped_event_id=$(append_verified_group "$obligation_id" "$actor" "$receipt" "$evidence_file" "$1" "$grouped_scope" "$grouped_origin") || return $?
      printf 'Event ID: %s\nFinding count: %s\n' "$grouped_event_id" "$grouped_count"
      return
    fi
    grouped_event_id=$(append_role_result_group "$obligation_id" "$actor" "$receipt" "$evidence_file" "$result_kind" "$claim_revision" "$grouped_scope" "$grouped_origin") || return $?
    printf 'Event ID: %s\nFinding count: %s\n' "$grouped_event_id" "$grouped_count"
    return
  fi

  if [ "$result_kind" = FindingReported ]; then
    [ -n "${GDD_FINDING_SCOPE:-}" ] || fail 'FindingReported requires finding scope metadata'
    [ -n "${GDD_FINDING_ORIGIN:-}" ] || fail 'FindingReported requires finding origin metadata'
    [ -n "${GDD_REPORT_COMPLETE:-}" ] || fail 'FindingReported requires report completeness metadata'
    local authorized_origin expected_scope
    authorized_origin=$(finding_origin_for_obligation "$obligation_id") \
      || fail "active obligation $obligation_id cannot authorize a finding report"
    [ "$GDD_FINDING_ORIGIN" = "$authorized_origin" ] \
      || fail "active obligation role $authorized_origin does not authorize finding origin $GDD_FINDING_ORIGIN"
    case "$obligation_id" in
      slice-*-*)
        expected_scope=${obligation_id#slice-}
        expected_scope=${expected_scope%%-*}
        [ "$GDD_FINDING_SCOPE" = "$expected_scope" ] || fail "finding scope $GDD_FINDING_SCOPE does not match active scope $expected_scope"
        ;;
      feature-branch-review|feature-security-review)
        [ "$GDD_FINDING_SCOPE" = feature ] || fail "$authorized_origin finding must use feature scope"
        ;;
    esac
    local finding_id metadata_temp event_id existing_report evidence_digest
    evidence_digest=$(sha256_file "$evidence_file")
    existing_report=$(reported_finding_for_receipt_evidence "$receipt" "$evidence_digest" "$GDD_FINDING_SCOPE" "$GDD_FINDING_ORIGIN")
    if [ -n "$existing_report" ]; then
      IFS=$'\t' read -r event_id finding_id <<<"$existing_report"
      printf 'Event ID: %s\nFinding ID: %s\n' "$event_id" "$finding_id"
      return
    fi
    finding_id=$(next_finding_id)
    GDD_FINDING_ID=$finding_id
    GDD_FINDING_STATE=REPORTED
    GDD_FINDING_EVENT_NAME=report
    metadata_temp=$(mktemp)
    append_result_metadata "$metadata_temp" "$result_kind" "$evidence_digest" "$claim_revision" "$actor"
    event_id=$(append_staged_event "$obligation_id" SIDE "$actor" "$receipt" "$evidence_file" result "$metadata_temp" "$@") || {
      rm -f "$metadata_temp"
      return 75
    }
    rm -f "$metadata_temp"
    printf 'Event ID: %s\nFinding ID: %s\n' "$event_id" "$finding_id"
    return
  fi

  obligation_allowed_result "$obligation_id" "$result_kind" || fail "result kind $result_kind is not allowed for $obligation_id"
  if [ "$result_kind" = FindingDispositionRecorded ] && [ "${GDD_FINDING_STATE:-}" = BLOCKED ]; then
    [ -n "${GDD_BLOCKING_BOUNDARY:-}" ] || fail 'BLOCKED requires blocking boundary metadata'
    awk -F '\t' -v expected="$GDD_BLOCKING_BOUNDARY" 'NR > 1 && $1 == expected { found=1 } END { exit !found }' "$workflow/obligations.tsv" \
      || fail "BLOCKED boundary is not a static lifecycle obligation: $GDD_BLOCKING_BOUNDARY"
  fi
  if [ "$result_kind" = SliceVerifiedMacro ]; then
    [ $# -eq 1 ] || fail 'SliceVerifiedMacro requires one final-suite evidence file'
    local grouped_event_id
    grouped_event_id=$(append_verified_group "$obligation_id" "$actor" "$receipt" "$evidence_file" "$1") || return $?
    printf 'Event ID: %s\n' "$grouped_event_id"
    return
  fi
  accept_action "$receipt" "$result_kind" "$evidence_file" "$@"
}

release_action() {
  local receipt=$1
  local evidence_file=$2
  [ -f "$evidence_file" ] || fail "release evidence is missing: $evidence_file"
  grep -qxF 'Status: DISPATCH_FAILED' "$evidence_file" || fail 'release evidence must contain Status: DISPATCH_FAILED'
  local active_claim obligation_id actor active_receipt claim_revision event_id metadata_temp released_event_id
  released_event_id=$(released_event_for_receipt "$receipt")
  if [ -n "$released_event_id" ]; then
    printf 'Event ID: %s\n' "$released_event_id"
    return
  fi
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -n "$active_claim" ] || fail 'receipt does not match the active claim'
  IFS=$'\t' read -r obligation_id actor active_receipt claim_revision event_id <<<"$active_claim"
  [ "$receipt" = "$active_receipt" ] || fail 'receipt does not match the active claim'
  metadata_temp=$(mktemp)
  printf 'release-reason\tDISPATCH_FAILED\n' >"$metadata_temp"
  event_id=$(append_staged_event "$obligation_id" RELEASE "$actor" "$receipt" "$evidence_file" release "$metadata_temp") || {
    rm -f "$metadata_temp"
    return 75
  }
  rm -f "$metadata_temp"
  printf 'Event ID: %s\n' "$event_id"
}

set_projected_slice_state() {
  local state_file=$1
  local slice_number=$2
  local state=$3
  printf '%s\t%s\n' "$slice_number" "$state" >>"$state_file"
}

build_projection_stage() {
  local stage=$1
  mkdir -p "$stage/findings" "$stage/projections"
  : >"$stage/ledger.tsv"
  : >"$stage/findings.tsv"
  local state_history="$stage/slice-states.tsv"
  : >"$state_history"
  awk -F '\t' 'NR > 1 && $2 ~ /^slice-[1-9][0-9]*$/ && !seen[$2]++ { value=$2; sub(/^slice-/, "", value); print value }' "$workflow/obligations.tsv" | while IFS= read -r slice_number; do
    set_projected_slice_state "$state_history" "$slice_number" QUEUED
  done

  local sequence event_id obligation_id event_kind evidence_path metadata_file result_kind finding_id finding_scope finding_origin finding_state finding_event_name target_slice projected_state event_token
  while IFS=$'\t' read -r sequence _revision event_id obligation_id event_kind _actor _receipt evidence_path _evidence_sha256 _previous_hash _event_hash; do
    [ "$sequence" = sequence ] && continue
    metadata_file="$workflow/events/$event_id/metadata.tsv"
    result_kind=''
    [ ! -f "$metadata_file" ] || result_kind=$(metadata_value "$metadata_file" result-kind)
    case "$event_kind:$obligation_id" in
      CLAIM:slice-*-implementer)
        target_slice=${obligation_id#slice-}
        target_slice=${target_slice%-implementer}
        set_projected_slice_state "$state_history" "$target_slice" IMPLEMENTING
        printf '%s\t%s\trevision-%s\t%s\n' "$target_slice" IMPLEMENTING "$sequence" "$evidence_path" >>"$stage/ledger.tsv"
        ;;
      ACCEPT:slice-*-implementer) projected_state=REVIEWING ;;
      ACCEPT:slice-*-review) projected_state='VERIFYING: CLEANER' ;;
      ACCEPT:slice-*-cleaner) projected_state='VERIFYING: ARCHITECT' ;;
      ACCEPT:slice-*-architect) projected_state='VERIFYING: HARDENER' ;;
      ACCEPT:slice-*-hardener) projected_state='VERIFYING: QA' ;;
      ACCEPT:slice-*-verified) projected_state=VERIFIED ;;
      *) projected_state='' ;;
    esac
    [ "$result_kind" != FAIL ] || projected_state=''
    if [ -n "$projected_state" ]; then
      target_slice=${obligation_id#slice-}
      target_slice=${target_slice%-*}
      set_projected_slice_state "$state_history" "$target_slice" "$projected_state"
      printf '%s\t%s\trevision-%s\t%s\n' "$target_slice" "$projected_state" "$sequence" "$evidence_path" >>"$stage/ledger.tsv"
    fi
    [ -f "$metadata_file" ] || continue
    finding_id=$(metadata_value "$metadata_file" finding-id)
    [ -n "$finding_id" ] || continue
    finding_scope=$(metadata_value "$metadata_file" finding-scope)
    finding_origin=$(metadata_value "$metadata_file" finding-origin)
    finding_state=$(metadata_value "$metadata_file" finding-state)
    finding_event_name=$(metadata_value "$metadata_file" finding-event-name)
    if [ "$result_kind" = ReplayEntered ]; then
      target_slice=$(metadata_value "$metadata_file" target-slice)
      [ -n "$target_slice" ] || target_slice=$finding_scope
      case "$target_slice" in ''|feature) ;; *)
        set_projected_slice_state "$state_history" "$target_slice" REPAIRING
        printf '%s\t%s\trevision-%s\tfinding=%s;%s\n' "$target_slice" REPAIRING "$sequence" "$finding_id" "$evidence_path" >>"$stage/ledger.tsv"
        ;;
      esac
    fi
    if [ "$result_kind" = RepairAccepted ]; then
      target_slice=$(metadata_value "$metadata_file" target-slice)
      set_projected_slice_state "$state_history" "$target_slice" 'VERIFYING: CLEANER'
      printf '%s\t%s\trevision-%s\t%s\n' "$target_slice" 'VERIFYING: CLEANER' "$sequence" "$evidence_path" >>"$stage/ledger.tsv"
    fi
    [ -n "$finding_state" ] || continue
    printf -v event_token '%06d-%s' "$sequence" "${finding_event_name:-event}"
    mkdir -p "$stage/findings/$finding_id/events/$event_token"
    printf '%s\n' "${finding_event_name:-event}" >"$stage/findings/$finding_id/events/$event_token/kind"
    cp "$workflow/$evidence_path" "$stage/findings/$finding_id/events/$event_token/evidence.md"
    if [ -f "$workflow/events/$event_id/supporting-1" ]; then
      cp "$workflow/events/$event_id/supporting-1" "$stage/findings/$finding_id/events/$event_token/supporting-evidence.md"
    fi
    printf '%s\t%s\t%s\t%s\trevision-%s\tfindings/%s/events/%s\n' \
      "$finding_id" "$finding_scope" "$finding_origin" "$finding_state" "$sequence" "$finding_id" "$event_token" >>"$stage/findings.tsv"
  done <"$workflow/events.tsv"

  reduce_workflow >"$stage/projections/status.tsv"
  awk -F '\t' -v history_file="$state_history" '
    BEGIN {
      while ((getline line < history_file) > 0) {
        split(line, fields, "\t")
        historical[fields[1]] = fields[2]
      }
      close(history_file)
    }
    $1 ~ /^slice-[1-9][0-9]*-/ {
      split($1, parts, "-")
      slice = parts[2]
      role = parts[3]
      if (!(slice in state)) state[slice] = "QUEUED"
      if (role == "verified" && $2 == "COMPLETE") {
        state[slice] = "VERIFIED"
        next
      }
      if ($2 == "COMPLETE" || (slice in incomplete)) next
      incomplete[slice] = 1
      if (role == "implementer") state[slice] = ($2 == "CLAIMED" ? "IMPLEMENTING" : "QUEUED")
      else if (role == "review") state[slice] = "REVIEWING"
      else if (role == "cleaner") state[slice] = "VERIFYING: CLEANER"
      else if (role == "architect") state[slice] = "VERIFYING: ARCHITECT"
      else if (role == "hardener") state[slice] = "VERIFYING: HARDENER"
      else state[slice] = "VERIFYING: QA"
    }
    END {
      for (slice in state) {
        if (historical[slice] == "REPAIRING") state[slice] = "REPAIRING"
        print slice "\t" state[slice]
      }
    }
  ' "$stage/projections/status.tsv" | sort -n >"$stage/latest-slice-states.tsv"
  awk -F '\t' -v states_file="$stage/latest-slice-states.tsv" '
    BEGIN {
      while ((getline state_line < states_file) > 0) {
        split(state_line, fields, "\t")
        states[fields[1]] = fields[2]
      }
      close(states_file)
    }
    /^## [1-9][0-9]*\. / {
      slice=$0
      sub(/^## /, "", slice)
      sub(/\. .*/, "", slice)
    }
    /^\*\*Slice state:\*\*/ {
      state=states[slice]
      if (state == "QUEUED") print "**Slice state:** [ ] QUEUED"
      else if (state == "VERIFIED") print "**Slice state:** [x] VERIFIED"
      else print "**Slice state:** [~] " state
      next
    }
    $0 ~ "^- \\[[ x]\\] " slice "\\.V \\*\\*Slice verification gate\\*\\*$" {
      if (states[slice] == "VERIFIED") print "- [x] " slice ".V **Slice verification gate**"
      else print "- [ ] " slice ".V **Slice verification gate**"
      next
    }
    { print }
  ' "$tasks_file" >"$stage/tasks.md"
}

projection_directory_digest() {
  local directory=$1
  {
    local file
    while IFS= read -r file; do
      printf '%s\t%s\n' "${file#"$directory/"}" "$(sha256_file "$file")"
    done < <(find "$directory" -type f -print | sort)
  } | {
    if command -v shasum >/dev/null 2>&1; then
      shasum -a 256 | awk '{ print $1 }'
    else
      sha256sum | awk '{ print $1 }'
    fi
  }
}

projection_artifact_source() {
  local transaction=$1
  case "$2" in
    tasks) printf '%s\n' "$transaction/tasks.md" ;;
    ledger) printf '%s\n' "$transaction/ledger.tsv" ;;
    findings-tsv) printf '%s\n' "$transaction/findings.tsv" ;;
    findings) printf '%s\n' "$transaction/findings" ;;
    status) printf '%s\n' "$transaction/projections/status.tsv" ;;
    *) return 1 ;;
  esac
}

projection_artifact_destination() {
  case "$1" in
    tasks) printf '%s\n' "$tasks_file" ;;
    ledger) printf '%s\n' "$workspace/ledger.tsv" ;;
    findings-tsv) printf '%s\n' "$workspace/findings.tsv" ;;
    findings) printf '%s\n' "$workspace/findings" ;;
    status) printf '%s\n' "$workflow/projections/status.tsv" ;;
    *) return 1 ;;
  esac
}

projection_artifact_digest() {
  local artifact=$1
  local path=$2
  if [ "$artifact" = findings ]; then
    [ -d "$path" ] || return 1
    projection_directory_digest "$path"
  else
    [ -f "$path" ] || return 1
    sha256_file "$path"
  fi
}

write_projection_manifest() {
  local transaction=$1
  local artifact source
  printf '%s\n' $'artifact\tdestination\tsha256' >"$transaction/manifest.tsv"
  for artifact in tasks ledger findings-tsv findings status; do
    source=$(projection_artifact_source "$transaction" "$artifact")
    printf '%s\t%s\t%s\n' "$artifact" "$artifact" "$(projection_artifact_digest "$artifact" "$source")" >>"$transaction/manifest.tsv"
  done
}

projection_recoverable_error() {
  printf '%s\n' 'gdd-workflow-state: journal accepted; projection rebuild is recoverable' >&2
}

publish_projection_transaction() {
  local transaction="$workflow/.projection-transaction"
  [ -d "$transaction" ] || return
  [ -f "$transaction/manifest.tsv" ] || {
    projection_recoverable_error
    return 1
  }
  local artifact _destination_label expected_digest source destination actual_digest published_count=0
  while IFS=$'\t' read -r artifact _destination_label expected_digest; do
    [ "$artifact" = artifact ] && continue
    source=$(projection_artifact_source "$transaction" "$artifact") || return 1
    destination=$(projection_artifact_destination "$artifact") || return 1
    if [ -e "$source" ]; then
      mkdir -p "$(dirname "$destination")"
      if [ "$artifact" = findings ]; then
        local findings_backup="$workflow/.projection-findings-backup"
        if [ -e "$destination" ] && [ ! -e "$findings_backup" ]; then
          mv "$destination" "$findings_backup"
        fi
        mv "$source" "$destination"
      else
        mv "$source" "$destination"
      fi
    fi
    actual_digest=$(projection_artifact_digest "$artifact" "$destination") || {
      projection_recoverable_error
      return 1
    }
    [ "$actual_digest" = "$expected_digest" ] || {
      projection_recoverable_error
      return 1
    }
    published_count=$((published_count + 1))
    if [ "${GDD_WORKFLOW_TEST_INTERRUPT_PROJECTION_AT:-}" = "$published_count" ]; then
      projection_recoverable_error
      return 77
    fi
  done <"$transaction/manifest.tsv"
  # Every manifest artifact now verifies, so the journal can regenerate the previous findings tree.
  rm -rf "$workflow/.projection-findings-backup"
  # The verified destinations make the consumed transaction stage disposable.
  rm -rf "$transaction"
}

prepare_projection_transaction() {
  local transaction="$workflow/.projection-transaction"
  local stage="$workflow/.projection-build.$$"
  [ ! -e "$transaction" ] || return 1
  # This process owns the PID-scoped build stage, which contains projections only.
  rm -rf "$stage"
  if ! build_projection_stage "$stage"; then
    # A failed build never becomes the recorded projection transaction.
    rm -rf "$stage"
    projection_recoverable_error
    return 1
  fi
  write_projection_manifest "$stage"
  mv "$stage" "$transaction"
}

project_workflow() {
  if [ -d "$workflow/.projection-transaction" ]; then
    publish_projection_transaction || return $?
  fi
  prepare_projection_transaction || {
    projection_recoverable_error
    return 1
  }
  if [ "${GDD_WORKFLOW_TEST_FAIL_PROJECTION:-}" = 1 ]; then
    projection_recoverable_error
    return 1
  fi
  publish_projection_transaction
}

status_with_projection() {
  local reduced
  if ! reduced=$(reduce_workflow); then
    printf '%s\n' "$reduced"
    return 1
  fi
  project_workflow || return 1
  print_status
}

next_with_projection() {
  local reduced
  if ! reduced=$(reduce_workflow); then
    printf '%s\n' "$reduced"
    return 1
  fi
  project_workflow || return 1
  select_next
}

require_active_feature_claim() {
  local expected_obligation=$1
  local active_claim
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -n "$active_claim" ] || fail "no active claim authorizes $expected_obligation"
  IFS=$'\t' read -r active_obligation active_actor active_receipt active_revision active_event_id <<<"$active_claim"
  [ "$active_obligation" = "$expected_obligation" ] \
    || fail "active claim is $active_obligation, not $expected_obligation"
  printf '%s\t%s\t%s\n' "$active_actor" "$active_receipt" "$active_revision"
}

write_findings_digest() {
  local output_file=$1
  local _sequence _revision event_id _obligation_id _event_kind _actor _receipt _evidence_path evidence_sha256 _previous_hash _event_hash metadata_file result_kind finding_id facts_file
  facts_file=$(mktemp)
  trap 'rm -f "$facts_file"' RETURN
  printf '%s\n' 'Findings digest:' >"$output_file"
  while IFS=$'\t' read -r _sequence _revision event_id _obligation_id _event_kind _actor _receipt _evidence_path evidence_sha256 _previous_hash _event_hash; do
    [ "$event_id" = event_id ] && continue
    metadata_file="$workflow/events/$event_id/metadata.tsv"
    result_kind=$(metadata_value "$metadata_file" result-kind)
    finding_id=$(metadata_value "$metadata_file" finding-id)
    [ -n "$finding_id" ] || continue
    case "$result_kind" in
      FindingReported)
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$_sequence" "$finding_id" "$(metadata_value "$metadata_file" finding-origin)" REPORTED '' '' '' >>"$facts_file"
        ;;
      FindingDispositionRecorded)
        printf '%s\t%s\t\t%s\t%s\t%s\t%s\n' \
          "$_sequence" "$finding_id" "$(metadata_value "$metadata_file" finding-state)" \
          "$(metadata_value "$metadata_file" finding-ruling)" \
          "$(metadata_value "$metadata_file" cost-if-wrong)" \
          "$(metadata_value "$metadata_file" wake-condition)" "$evidence_sha256" >>"$facts_file"
        ;;
    esac
  done <"$workflow/events.tsv"
  awk -F '\t' '
    $3 != "" { origin[$2] = $3 }
    {
      state[$2] = $4
      if ($5 != "") ruling[$2] = $5
      if ($6 != "") cost[$2] = $6
      if ($7 != "") wake[$2] = $7
      if ($8 != "") digest[$2] = $8
    }
    END {
      for (id in state) {
        if (state[id] == "DEFERRED" || state[id] == "DISMISSED" || state[id] == "PARKED" || state[id] == "BLOCKED") {
          print id "\t" origin[id] "\t" ruling[id] "\t" cost[id] "\t" wake[id] "\t" digest[id]
        }
      }
    }
  ' "$facts_file" | sort -t $'\t' -k1,1 | while IFS=$'\t' read -r current_finding_id current_origin current_ruling current_cost current_wake current_digest; do
    printf 'Finding ID: %s\nOrigin: %s\nRuling: %s\nCost if wrong: %s\nWake condition: %s\nEvidence digest: %s\n\n' \
      "$current_finding_id" "$current_origin" "$current_ruling" "$current_cost" "$current_wake" "$current_digest" \
      >>"$output_file"
  done
  rm -f "$facts_file"
  trap - RETURN
}

digest_action() {
  local output_file=$1
  [ ! -e "$output_file" ] || fail "digest output already exists: $output_file"
  local active_actor active_receipt active_revision
  IFS=$'\t' read -r active_actor active_receipt active_revision <<<"$(require_active_feature_claim feature-findings-digest)"
  write_findings_digest "$output_file"
  accept_action "$active_receipt" FindingsDigestWritten "$output_file"
}

complete_action() {
  local evidence_file=$1
  [ ! -e "$evidence_file" ] || fail "completion evidence already exists: $evidence_file"
  local reduced
  reduced=$(reduce_workflow) || fail 'workflow-v1 is invalid'
  if ! printf '%s\n' "$reduced" | awk -F '\t' '$1 != "feature-complete" && $2 != "COMPLETE" { exit 1 }'; then
    fail 'completion has unsatisfied required obligations'
  fi
  local active_actor active_receipt active_revision
  IFS=$'\t' read -r active_actor active_receipt active_revision <<<"$(require_active_feature_claim feature-complete)"
  local branch_evidence branch_digest digest_evidence digest_sha256 journal_head
  IFS=$'\t' read -r branch_evidence branch_digest < <(awk -F '\t' '$4 == "feature-branch-review" && $5 == "ACCEPT" { path = $8; digest = $9 } END { print path "\t" digest }' "$workflow/events.tsv")
  IFS=$'\t' read -r digest_evidence digest_sha256 < <(awk -F '\t' '$4 == "feature-findings-digest" && $5 == "ACCEPT" { path = $8; digest = $9 } END { print path "\t" digest }' "$workflow/events.tsv")
  [ -n "$branch_evidence" ] || fail 'completion requires branch review evidence'
  [ -n "$digest_evidence" ] || fail 'completion requires findings digest evidence'
  journal_head=$(awk -F '\t' 'NR > 1 { value = $11 } END { print value }' "$workflow/events.tsv")
  {
    printf '%s\n' 'Workflow status: COMPLETE'
    printf 'Workflow revision: %s\n' "$(current_revision)"
    printf 'Journal head SHA-256: %s\n' "$journal_head"
    printf 'Branch review evidence: %s\n' "$branch_evidence"
    printf 'Findings digest: %s %s\n' "$digest_evidence" "$digest_sha256"
  } >"$evidence_file"
  local metadata_file event_id
  metadata_file=$(mktemp)
  append_result_metadata "$metadata_file" COMPLETE "$(sha256_file "$evidence_file")" "$active_revision" "$active_actor"
  event_id=$(append_staged_event feature-complete COMPLETE "$active_actor" "$active_receipt" "$evidence_file" completion "$metadata_file") || {
    rm -f "$metadata_file"
    return $?
  }
  rm -f "$metadata_file"
  printf 'Event ID: %s\nCompletion evidence: %s\n' "$event_id" "$evidence_file"
}

[ $# -ge 2 ] || usage
plan=$1
command=$2
shift 2
script_dir="$(cd "$(dirname "$0")" && pwd)"
finding_policy="$script_dir/../finding-policy.md"
workspace=''
workflow=''
tasks_file=''

case "$command" in
  init)
    [ $# -eq 0 ] || usage
    require_plan
    initialize_workflow
    ;;
  status)
    [ $# -eq 0 ] || usage
    require_plan
    require_workflow
    run_locked status_with_projection || fail 'workflow-v1 is invalid or its projection could not be rebuilt'
    ;;
  next)
    [ $# -eq 0 ] || usage
    require_plan
    require_workflow
    run_locked next_with_projection || fail 'workflow-v1 is invalid or its projection could not be rebuilt'
    ;;
  format-version)
    [ $# -eq 0 ] || usage
    if [ -f "$plan" ]; then
      workspace=$("$script_dir/gdd-workspace" "$plan") || exit $?
      workflow="$workspace/workflow-v1"
      if [ -d "$workflow" ]; then
        require_workflow
      fi
    fi
    printf '%s\n' 2
    ;;
  claim)
    [ $# -eq 3 ] || usage
    require_plan
    require_workflow
    run_locked claim_action "$1" "$2" "$3"
    ;;
  accept)
    [ $# -ge 3 ] || usage
    require_plan
    require_workflow
    run_locked accept_action "$@"
    ;;
  accept-active)
    [ $# -ge 3 ] || usage
    require_plan
    require_workflow
    run_locked accept_active_action "$@"
    run_locked project_workflow || fail 'journal accepted; projection rebuild is recoverable'
    ;;
  release)
    [ $# -eq 2 ] || usage
    require_plan
    require_workflow
    run_locked release_action "$1" "$2"
    ;;
  project)
    [ $# -eq 0 ] || usage
    require_plan
    require_workflow
    run_locked project_workflow
    ;;
  digest)
    [ $# -eq 1 ] || usage
    require_plan
    require_workflow
    run_locked digest_action "$1"
    ;;
  complete)
    [ $# -eq 1 ] || usage
    require_plan
    require_workflow
    run_locked complete_action "$1"
    ;;
  *) usage ;;
esac
