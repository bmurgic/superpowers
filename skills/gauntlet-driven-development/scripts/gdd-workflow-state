#!/usr/bin/env bash
# Create and project the append-only v1 GDD obligation journal.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  gdd-workflow-state PLAN_FILE init
  gdd-workflow-state PLAN_FILE status
  gdd-workflow-state PLAN_FILE next
  gdd-workflow-state PLAN_FILE format-version
  gdd-workflow-state PLAN_FILE claim OBLIGATION_ID ACTOR DISPATCH_FILE
  gdd-workflow-state PLAN_FILE accept RECEIPT RESULT_KIND EVIDENCE_FILE [SUPPORTING_FILE...]
  gdd-workflow-state PLAN_FILE accept-active OBLIGATION_ID RESULT_KIND EVIDENCE_FILE [SUPPORTING_FILE...]
  gdd-workflow-state PLAN_FILE release RECEIPT EVIDENCE_FILE
  gdd-workflow-state PLAN_FILE project
  gdd-workflow-state PLAN_FILE digest OUTPUT_FILE
  gdd-workflow-state PLAN_FILE complete EVIDENCE_FILE
EOF
  exit 2
}

fail() {
  printf 'gdd-workflow-state: %s\n' "$1" >&2
  exit 1
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  else
    sha256sum "$1" | awk '{ print $1 }'
  fi
}

sha256_values() {
  local value
  for value in "$@"; do
    case "$value" in
      *$'\t'*|*$'\r'*|*$'\n'*) fail 'scalar field values cannot contain tabs, carriage returns, or newlines' ;;
    esac
  done
  {
    printf '%s' "$1"
    shift
    for value in "$@"; do
      printf '\t%s' "$value"
    done
  } | {
    if command -v shasum >/dev/null 2>&1; then
      shasum -a 256 | awk '{ print $1 }'
    else
      sha256sum | awk '{ print $1 }'
    fi
  }
}

require_plan() {
  [ -f "$plan" ] || fail "no such plan file: $plan"
  tasks_file="$(dirname "$plan")/tasks.md"
  [ -f "$tasks_file" ] || fail "no tasks.md beside plan: $tasks_file"
}

read_slice_numbers() {
  awk '
    function stop(message) {
      print "gdd-workflow-state: " message > "/dev/stderr"
      failed = 1
      exit 1
    }
    function finish_slice() {
      if (!inside) {
        return
      }
      if (state_count != 1) {
        stop("slice " slice_number " must contain exactly one Slice state line")
      }
      if (state_line != "**Slice state:** [ ] QUEUED") {
        stop("slice " slice_number " has unsupported Slice state metadata: " state_line)
      }
      if (gate_count != 1) {
        stop("slice " slice_number " must contain exactly one Slice verification gate")
      }
    }
    /^## [1-9][0-9]*\. / {
      finish_slice()
      slice_number = $0
      sub(/^## /, "", slice_number)
      sub(/\. .*/, "", slice_number)
      if (seen[slice_number]++) {
        stop("duplicate slice number: " slice_number)
      }
      slices[++slice_count] = slice_number
      state_count = 0
      gate_count = 0
      state_line = ""
      inside = 1
      next
    }
    inside && /^\*\*Slice state:\*\*/ {
      state_count++
      state_line = $0
      next
    }
    inside && $0 == "- [ ] " slice_number ".V **Slice verification gate**" {
      gate_count++
    }
    END {
      if (!failed) {
        finish_slice()
      }
      if (!failed && slice_count == 0) {
        stop("tasks.md has no numbered slices")
      }
      if (!failed) {
        for (position = 1; position <= slice_count; position++) {
          print slices[position]
        }
      }
    }
  ' "$tasks_file"
}

compile_obligations() {
  local output_file=$1
  local slice_numbers
  slice_numbers=$(read_slice_numbers) || return 1

  printf '%s\n' 'obligation_id	scope	type	prerequisites	allowed_results	blocking_boundary	evidence_contract' >"$output_file"

  local prior_verified='-'
  local verified_obligations=''
  local slice_number
  while IFS= read -r slice_number; do
    [ -n "$slice_number" ] || continue
    local scope="slice-$slice_number"
    local implementer="slice-$slice_number-implementer"
    local cleaner="slice-$slice_number-cleaner"
    local architect="slice-$slice_number-architect"
    local security="slice-$slice_number-security"
    local hardener="slice-$slice_number-hardener"
    local qa="slice-$slice_number-qa"
    local final_suite="slice-$slice_number-final-suite"
    local verified="slice-$slice_number-verified"

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$implementer" "$scope" implementer "$prior_verified" 'PASS,FAIL' slice 'implementer-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$cleaner" "$scope" cleaner "$implementer" 'PASS,FAIL' slice 'cleaner-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$architect" "$scope" architect "$cleaner" 'PASS,FAIL' slice 'architect-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$security" "$scope" security "$architect" 'PASS,FAIL' slice 'security-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$hardener" "$scope" hardener "$security" 'PASS,FAIL' slice 'hardener-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$qa" "$scope" qa "$hardener" 'PASS,FAIL' slice 'qa-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$final_suite" "$scope" final-suite "$qa" 'PASS,FAIL' slice 'final-suite-report' >>"$output_file"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$verified" "$scope" verified "$final_suite" PASS slice 'verification-record' >>"$output_file"

    prior_verified=$verified
    if [ -z "$verified_obligations" ]; then
      verified_obligations=$verified
    else
      verified_obligations="$verified_obligations,$verified"
    fi
  done <<<"$slice_numbers"

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-branch-review feature branch-review "$verified_obligations" 'PASS,FAIL' feature 'branch-review-report' >>"$output_file"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-findings-digest feature findings-digest feature-branch-review PASS feature 'findings-digest' >>"$output_file"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' feature-complete feature complete feature-findings-digest PASS feature 'completion-evidence' >>"$output_file"
}

validate_obligations() {
  local obligations_file=$1
  [ -f "$obligations_file" ] || { printf '%s\n' 'obligations.tsv is missing' >&2; return 1; }

  awk -F '\t' '
    function invalid(message) {
      print "gdd-workflow-state: " message > "/dev/stderr"
      invalid_graph = 1
      exit 1
    }
    function visit(identifier, dependency_count, dependencies, position, dependency) {
      if (color[identifier] == 1) {
        invalid("obligation graph contains a cycle at " identifier)
      }
      if (color[identifier] == 2) {
        return
      }
      color[identifier] = 1
      if (prerequisites[identifier] != "-") {
        dependency_count = split(prerequisites[identifier], dependencies, ",")
        for (position = 1; position <= dependency_count; position++) {
          dependency = dependencies[position]
          visit(dependency)
        }
      }
      color[identifier] = 2
    }
    NR == 1 {
      expected = "obligation_id\tscope\ttype\tprerequisites\tallowed_results\tblocking_boundary\tevidence_contract"
      if ($0 != expected) {
        invalid("obligations.tsv has an invalid header")
      }
      next
    }
    {
      if (NF != 7) {
        invalid("obligation record must contain seven tab-separated fields")
      }
      if ($1 !~ /^(slice-[1-9][0-9]*-(implementer|cleaner|architect|security|hardener|qa|final-suite|verified)|feature-(branch-review|findings-digest|complete))$/) {
        invalid("obligation has an invalid ID: " $1)
      }
      if (seen[$1]++) {
        invalid("duplicate obligation ID: " $1)
      }
      prerequisites[$1] = $4
      identifiers[++count] = $1
    }
    END {
      if (NR == 0) {
        invalid("obligations.tsv is empty")
      }
      if (!invalid_graph) {
        for (identifier in prerequisites) {
          if (prerequisites[identifier] == "-") {
            continue
          }
          dependency_count = split(prerequisites[identifier], dependencies, ",")
          for (position = 1; position <= dependency_count; position++) {
            dependency = dependencies[position]
            if (!(dependency in prerequisites)) {
              invalid("obligation " identifier " references an unknown prerequisite: " dependency)
            }
          }
        }
      }
      if (!invalid_graph) {
        for (position = 1; position <= count; position++) {
          visit(identifiers[position])
        }
      }
    }
  ' "$obligations_file"
}

validate_event_chain() {
  local events_file=$1
  local events_root=$2
  [ -f "$events_file" ] || { printf '%s\n' 'events.tsv is missing' >&2; return 1; }
  local expected_header=$'sequence\trevision\tevent_id\tobligation_id\tkind\tactor\treceipt\tevidence_path\tevidence_sha256\tprevious_hash\tevent_hash'
  local header
  IFS= read -r header <"$events_file" || { printf '%s\n' 'events.tsv is empty' >&2; return 1; }
  [ "$header" = "$expected_header" ] || { printf '%s\n' 'events.tsv has an invalid header' >&2; return 1; }

  awk -F '\t' 'NR > 1 && NF != 11 { exit 1 }' "$events_file" \
    || { printf '%s\n' 'events.tsv contains a malformed record' >&2; return 1; }

  local expected_sequence=1
  local expected_revision=1
  local previous_hash='-'
  local active_receipt=''
  local event_line event_remainder
  local -a event_fields
  local sequence revision event_id obligation_id kind actor receipt evidence_path evidence_sha256 recorded_previous_hash event_hash
  while IFS= read -r event_line || [ -n "$event_line" ]; do
    [ -n "$event_line" ] || continue
    event_fields=()
    event_remainder=$event_line
    while [[ "$event_remainder" == *$'\t'* ]]; do
      event_fields+=("${event_remainder%%$'\t'*}")
      event_remainder=${event_remainder#*$'\t'}
    done
    event_fields+=("$event_remainder")
    sequence=${event_fields[0]}
    revision=${event_fields[1]}
    event_id=${event_fields[2]}
    obligation_id=${event_fields[3]}
    kind=${event_fields[4]}
    actor=${event_fields[5]}
    receipt=${event_fields[6]}
    evidence_path=${event_fields[7]}
    evidence_sha256=${event_fields[8]}
    recorded_previous_hash=${event_fields[9]}
    event_hash=${event_fields[10]}
    [ -n "$sequence" ] || continue
    case "$sequence:$revision" in
      *[!0-9:]*|:*|*:) printf '%s\n' 'event sequence and revision must be positive integers' >&2; return 1 ;;
    esac
    [ "$sequence" -eq "$expected_sequence" ] || { printf '%s\n' "event sequence gap at $sequence" >&2; return 1; }
    [ "$revision" -eq "$expected_revision" ] || { printf '%s\n' "event revision gap at $revision" >&2; return 1; }
    case "$kind" in CLAIM|ACCEPT|RELEASE|COMPLETE|EvidenceInvalidated) ;; *) printf '%s\n' "unknown event kind: $kind" >&2; return 1 ;; esac
    if [ "$kind" = CLAIM ] && [ -z "$receipt" ]; then
      printf '%s\n' "claim receipt is empty at sequence $sequence" >&2
      return 1
    fi
    case "$evidence_path" in ''|/*|*'..'*|*$'\r'*|*$'\n'*) printf '%s\n' "invalid event evidence path: $evidence_path" >&2; return 1 ;; esac
    [ "$recorded_previous_hash" = "$previous_hash" ] || { printf '%s\n' "broken event hash chain at sequence $sequence" >&2; return 1; }
    [ -f "$events_root/$evidence_path" ] || { printf '%s\n' "event evidence is missing: $evidence_path" >&2; return 1; }
    [ "$(sha256_file "$events_root/$evidence_path")" = "$evidence_sha256" ] || { printf '%s\n' "event evidence digest does not match: $evidence_path" >&2; return 1; }
    local calculated_hash
    calculated_hash=$(sha256_values "$sequence" "$revision" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_sha256" "$recorded_previous_hash")
    [ "$calculated_hash" = "$event_hash" ] || { printf '%s\n' "broken event hash at sequence $sequence" >&2; return 1; }
    case "$kind" in
      CLAIM)
        [ -z "$active_receipt" ] || { printf '%s\n' "overlapping claim at sequence $sequence" >&2; return 1; }
        active_receipt=$receipt
        ;;
      ACCEPT|RELEASE|COMPLETE)
        if [ "$receipt" = "$active_receipt" ]; then
          active_receipt=''
        fi
        ;;
    esac
    previous_hash=$event_hash
    expected_sequence=$((expected_sequence + 1))
    expected_revision=$((expected_revision + 1))
  done < <(tail -n +2 "$events_file")
}

validate_format_version() {
  local format_file="$workflow/format-version"
  [ -f "$format_file" ] || { printf '%s\n' 'workflow format version is missing' >&2; return 1; }
  local format_version
  format_version=$(cat "$format_file")
  [ "$format_version" = 1 ] || { printf '%s\n' "workflow format version is unknown: $format_version" >&2; return 1; }
}

reduce_workflow() {
  if ! validate_format_version; then
    printf '%s\n' INVALID
    return 1
  fi
  if ! validate_obligations "$workflow/obligations.tsv"; then
    printf '%s\n' INVALID
    return 1
  fi
  if ! validate_event_chain "$workflow/events.tsv" "$workflow"; then
    printf '%s\n' INVALID
    return 1
  fi

  awk -F '\t' '
    NR == FNR {
      if (FNR == 1) {
        next
      }
      prerequisites[$1] = $4
      ordered[++count] = $1
      next
    }
    FNR == 1 {
      next
    }
    $5 == "ACCEPT" || $5 == "COMPLETE" {
      completed[$4] = 1
    }
    $5 == "CLAIM" {
      active[$4] = 1
    }
    $5 == "RELEASE" || $5 == "ACCEPT" || $5 == "COMPLETE" {
      delete active[$4]
    }
    $5 == "EvidenceInvalidated" {
      delete completed[$4]
    }
    END {
      for (position = 1; position <= count; position++) {
        identifier = ordered[position]
        if (completed[identifier]) {
          state = "COMPLETE"
        } else if (active[identifier]) {
          state = "CLAIMED"
        } else {
          is_ready = 1
          if (prerequisites[identifier] != "-") {
            dependency_count = split(prerequisites[identifier], dependencies, ",")
            for (dependency_index = 1; dependency_index <= dependency_count; dependency_index++) {
              if (!completed[dependencies[dependency_index]]) {
                is_ready = 0
              }
            }
          }
          state = is_ready ? "READY" : "PENDING"
        }
        print identifier "\t" state
      }
    }
  ' "$workflow/obligations.tsv" "$workflow/events.tsv"
}

select_next() {
  local reduced
  if ! reduced=$(reduce_workflow); then
    printf '%s\n' "$reduced"
    return 1
  fi
  local active_claim
  active_claim=$(active_claim_record) || return 1
  if [ -n "$active_claim" ]; then
    local obligation_id actor receipt revision event_id
    IFS=$'\t' read -r obligation_id actor receipt revision event_id <<<"$active_claim"
    printf 'RESUME_CLAIM\nResume claim: %s\nReceipt: %s\n' "$obligation_id" "$receipt"
    return
  fi
  printf '%s\n' "$reduced" | awk -F '\t' '$2 == "READY" { print $1; exit }'
}

print_status() {
  local reduced
  if ! reduced=$(reduce_workflow); then
    printf '%s\n' "$reduced"
    return 1
  fi
  printf '%s\n' 'Workflow status: ACTIVE'

  local active_claim
  active_claim=$(printf '%s\n' "$reduced" | awk -F '\t' '$2 == "CLAIMED" { print $1; exit }')
  if [ -n "$active_claim" ]; then
    printf 'Active claim: %s\n' "$active_claim"
  else
    printf '%s\n' 'Active claim: none'
  fi

  local ready_obligation
  while IFS= read -r ready_obligation; do
    [ -n "$ready_obligation" ] && printf 'Ready obligation: %s\n' "$ready_obligation"
  done < <(printf '%s\n' "$reduced" | awk -F '\t' '$2 == "READY" { print $1 }')

  if printf '%s\n' "$reduced" | grep -qF $'feature-complete\tREADY'; then
    printf '%s\n' 'Completion eligible: yes'
  else
    printf '%s\n' 'Completion eligible: no'
  fi
}

initialize_workflow() {
  [ -f "$finding_policy" ] || fail "finding policy is missing: $finding_policy"
  local workspace_script="$script_dir/gdd-workspace"
  [ -x "$workspace_script" ] || fail "gdd-workspace is missing or not executable: $workspace_script"
  workspace=$("$workspace_script" "$plan") || exit $?
  workflow="$workspace/workflow-v1"

  if [ -e "$workflow" ]; then
    [ -f "$workflow/format-version" ] || fail 'workflow-v1 is incomplete'
    recover_existing_workflow
    print_status || fail 'workflow-v1 is invalid'
    return
  fi

  local stage="$workspace/.workflow-v1-stage.$$"
  [ ! -e "$stage" ] || fail "workflow initialization stage already exists: $stage"
  mkdir -p "$stage/events" "$stage/projections" "$stage/rejections" "$stage/recovery"
  printf '%s\n' 1 >"$stage/format-version"
  printf '%s\n' $'input\tsha256' >"$stage/input-digests.tsv"
  printf 'plan.md\t%s\n' "$(sha256_file "$plan")" >>"$stage/input-digests.tsv"
  printf 'tasks.md\t%s\n' "$(sha256_file "$tasks_file")" >>"$stage/input-digests.tsv"
  printf 'finding-policy.md\t%s\n' "$(sha256_file "$finding_policy")" >>"$stage/input-digests.tsv"
  compile_obligations "$stage/obligations.tsv" || { rm -rf "$stage"; return 1; }
  validate_obligations "$stage/obligations.tsv" || { rm -rf "$stage"; return 1; }
  printf '%s\n' $'sequence\trevision\tevent_id\tobligation_id\tkind\tactor\treceipt\tevidence_path\tevidence_sha256\tprevious_hash\tevent_hash' >"$stage/events.tsv"
  mv "$stage" "$workflow"
  print_status || fail 'new workflow-v1 is invalid'
}

require_workflow() {
  local workspace_script="$script_dir/gdd-workspace"
  [ -x "$workspace_script" ] || fail "gdd-workspace is missing or not executable: $workspace_script"
  workspace=$("$workspace_script" "$plan") || exit $?
  workflow="$workspace/workflow-v1"
  [ -d "$workflow" ] || fail "workflow-v1 is not initialized: $workflow"
  [ -f "$workflow/format-version" ] || fail 'workflow-v1 is incomplete'
  recover_existing_workflow
}

scalar_value() {
  case "$1" in
    *$'\t'*|*$'\r'*|*$'\n'*) fail 'scalar field values cannot contain tabs, carriage returns, or newlines' ;;
  esac
}

current_revision() {
  awk -F '\t' 'NR > 1 { revision = $2 } END { print revision }' "$workflow/events.tsv"
}

next_sequence() {
  local revision
  revision=$(current_revision)
  if [ -z "$revision" ]; then
    printf '%s\n' 1
  else
    printf '%s\n' $((revision + 1))
  fi
}

active_claim_record() {
  validate_event_chain "$workflow/events.tsv" "$workflow" || return 1
  awk -F '\t' '
    NR == 1 { next }
    $5 == "CLAIM" { obligation = $4; actor = $6; receipt = $7; revision = $2; event_id = $3 }
    ($5 == "ACCEPT" || $5 == "RELEASE" || $5 == "COMPLETE") && $7 == receipt {
      obligation = actor = receipt = revision = event_id = ""
    }
    END {
      if (receipt != "") {
        print obligation "\t" actor "\t" receipt "\t" revision "\t" event_id
      }
    }
  ' "$workflow/events.tsv"
}

obligation_allowed_result() {
  local obligation_id=$1
  local result_kind=$2
  awk -F '\t' -v expected_id="$obligation_id" -v expected_result="$result_kind" '
    NR > 1 && $1 == expected_id {
      count = split($5, allowed, ",")
      for (position = 1; position <= count; position++) {
        if (allowed[position] == expected_result) {
          exit 0
        }
      }
      exit 1
    }
    END { if (NR == 1) exit 1 }
  ' "$workflow/obligations.tsv"
}

metadata_value() {
  local metadata_file=$1
  local expected_key=$2
  awk -F '\t' -v expected_key="$expected_key" '$1 == expected_key { print $2; exit }' "$metadata_file"
}

accepted_event_for_receipt() {
  local expected_receipt=$1
  awk -F '\t' -v expected_receipt="$expected_receipt" 'NR > 1 && $5 == "ACCEPT" && $7 == expected_receipt { print $3; exit }' "$workflow/events.tsv"
}

released_event_for_receipt() {
  local expected_receipt=$1
  awk -F '\t' -v expected_receipt="$expected_receipt" 'NR > 1 && $5 == "RELEASE" && $7 == expected_receipt { print $3; exit }' "$workflow/events.tsv"
}

replay_obligations_for_repair() {
  local obligation_id=$1
  local scope=${obligation_id%-*}
  local replay_roles=''
  case "$obligation_id" in
    slice-[1-9]*-cleaner) replay_roles='cleaner' ;;
    slice-[1-9]*-architect) replay_roles='cleaner architect' ;;
    slice-[1-9]*-security) replay_roles='cleaner architect security' ;;
    slice-[1-9]*-hardener) replay_roles='cleaner architect security hardener' ;;
    slice-[1-9]*-qa) replay_roles='cleaner architect security hardener qa' ;;
    *) return ;;
  esac
  local replay_role
  for replay_role in $replay_roles; do
    printf '%s-%s\n' "$scope" "$replay_role"
  done
}

emit_repair_invalidations() {
  local obligation_id=$1
  local actor=$2
  local receipt=$3
  local evidence_file=$4
  local accepted_event_id=$5
  case "$actor" in fixer|fixer-max) ;; *) return ;; esac

  local replay_obligation metadata_file invalidation_event_id
  while IFS= read -r replay_obligation; do
    [ -n "$replay_obligation" ] || continue
    metadata_file=$(mktemp)
    {
      printf 'accepted-event-id\t%s\n' "$accepted_event_id"
      printf 'invalidated-obligation\t%s\n' "$replay_obligation"
    } >"$metadata_file"
    invalidation_event_id=$(append_staged_event "$replay_obligation" EvidenceInvalidated "$actor" "$receipt" "$evidence_file" invalidation "$metadata_file") || {
      rm -f "$metadata_file"
      return 75
    }
    rm -f "$metadata_file"
  done < <(replay_obligations_for_repair "$obligation_id")
}

event_path_for_id() {
  local event_id=$1
  awk -F '\t' -v expected_id="$event_id" 'NR > 1 && $3 == expected_id { print $8; exit }' "$workflow/events.tsv"
}

acquire_workflow_lock() {
  local lock="$workflow/.lock"
  if mkdir "$lock" 2>/dev/null; then
    printf '%s\n' "$$" >"$lock/pid"
    local process_start
    if process_start=$(ps -o lstart= -p "$$" 2>/dev/null); then
      printf '%s\n' "${process_start#"${process_start%%[! ]*}"}" >"$lock/process-start"
    else
      printf '%s\n' unavailable >"$lock/process-start"
    fi
    return
  fi

  local owner_pid=''
  [ -f "$lock/pid" ] && owner_pid=$(cat "$lock/pid")
  if [ -n "$owner_pid" ] && kill -0 "$owner_pid" 2>/dev/null; then
    local recorded_start current_start
    recorded_start=$(cat "$lock/process-start" 2>/dev/null || true)
    current_start=$(ps -o lstart= -p "$owner_pid" 2>/dev/null || true)
    if [ "$recorded_start" = unavailable ] || [ -z "$recorded_start" ] || [ "$recorded_start" = "${current_start#"${current_start%%[! ]*}"}" ]; then
      fail 'workflow is busy with one active action'
    fi
  fi
  mkdir -p "$workflow/recovery"
  mv "$lock" "$workflow/recovery/lock-${owner_pid:-unknown}-$$"
  acquire_workflow_lock
}

release_workflow_lock() {
  # The lock only protects this process's published journal transaction.
  rm -rf "$workflow/.lock"
}

recover_transactions() {
  local stage
  for stage in "$workflow"/.stage.*; do
    [ -d "$stage" ] || continue
    local manifest="$stage/transaction-manifest.tsv"
    if [ ! -f "$manifest" ]; then
      mkdir -p "$workflow/recovery"
      # Preserve an incomplete stage for audit instead of deleting unverified evidence.
      mv "$stage" "$workflow/recovery/rejected-stage-$(basename "$stage")"
      continue
    fi

    local valid=1 relative_path expected_digest
    while IFS=$'\t' read -r relative_path expected_digest; do
      [ "$relative_path" = path ] && continue
      if [ ! -f "$stage/$relative_path" ] || [ "$(sha256_file "$stage/$relative_path")" != "$expected_digest" ]; then
        valid=0
        break
      fi
    done <"$manifest"
    if [ "$valid" -ne 1 ]; then
      mkdir -p "$workflow/recovery"
      # Preserve a digest-mismatched stage because it cannot safely publish.
      mv "$stage" "$workflow/recovery/rejected-stage-$(basename "$stage")"
      continue
    fi

    local staged_event_directory
    for staged_event_directory in "$stage"/events/*; do
      [ -d "$staged_event_directory" ] || continue
      local published_directory="$workflow/events/$(basename "$staged_event_directory")"
      if [ ! -e "$published_directory" ]; then
        cp -R "$staged_event_directory" "$published_directory"
      fi
    done
    if ! cmp -s "$stage/events.tsv" "$workflow/events.tsv"; then
      mv "$stage/events.tsv" "$workflow/events.tsv"
    fi
    rm -f "$manifest"
    # The published journal and evidence make this verified stage disposable.
    rm -rf "$stage"
  done
}

run_locked() {
  acquire_workflow_lock
  recover_transactions
  local command_status=0
  if "$@"; then
    command_status=0
  else
    command_status=$?
  fi
  release_workflow_lock
  return "$command_status"
}

recover_existing_workflow() {
  run_locked :
}

append_staged_event() {
  local obligation_id=$1
  local kind=$2
  local actor=$3
  local receipt=$4
  local evidence_file=$5
  local evidence_name=$6
  local metadata_file=$7
  shift 7
  local sequence event_id evidence_path evidence_digest previous_hash event_hash stage
  sequence=$(next_sequence)
  event_id="event-$sequence"
  stage="$workflow/.stage.$$"
  [ ! -e "$stage" ] || fail "workflow transaction stage already exists: $stage"
  mkdir -p "$stage/events/$event_id"
  cp "$evidence_file" "$stage/events/$event_id/$evidence_name"
  cp "$metadata_file" "$stage/events/$event_id/metadata.tsv"
  local supporting_file supporting_index=1
  for supporting_file in "$@"; do
    [ -f "$supporting_file" ] || fail "supporting evidence is missing: $supporting_file"
    cp "$supporting_file" "$stage/events/$event_id/supporting-$supporting_index"
    supporting_index=$((supporting_index + 1))
  done
  evidence_path="events/$event_id/$evidence_name"
  evidence_digest=$(sha256_file "$stage/$evidence_path")
  previous_hash=$(awk -F '\t' 'NR > 1 { event_hash = $11 } END { print event_hash }' "$workflow/events.tsv")
  [ -n "$previous_hash" ] || previous_hash='-'
  event_hash=$(sha256_values "$sequence" "$sequence" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_digest" "$previous_hash")
  cp "$workflow/events.tsv" "$stage/events.tsv"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$sequence" "$sequence" "$event_id" "$obligation_id" "$kind" "$actor" "$receipt" "$evidence_path" "$evidence_digest" "$previous_hash" "$event_hash" \
    >>"$stage/events.tsv"
  {
    printf '%s\n' $'path\tsha256'
    find "$stage/events/$event_id" -type f -print | while IFS= read -r staged_file; do
      relative_path=${staged_file#"$stage/"}
      printf '%s\t%s\n' "$relative_path" "$(sha256_file "$staged_file")"
    done
    printf 'events.tsv\t%s\n' "$(sha256_file "$stage/events.tsv")"
  } >"$stage/transaction-manifest.tsv"
  cp -R "$stage/events/$event_id" "$workflow/events/$event_id"
  if [ "${GDD_WORKFLOW_TEST_INTERRUPT_AFTER_EVIDENCE:-}" = 1 ]; then
    return 75
  fi
  mv "$stage/events.tsv" "$workflow/events.tsv"
  rm -f "$stage/transaction-manifest.tsv"
  # The journal now references the copied immutable evidence directory.
  rm -rf "$stage"
  printf '%s\n' "$event_id"
}

claim_action() {
  local obligation_id=$1
  local actor=$2
  local dispatch_file=$3
  [ -f "$dispatch_file" ] || fail "dispatch evidence is missing: $dispatch_file"
  scalar_value "$obligation_id"
  scalar_value "$actor"
  local reduced ready_obligation active_claim
  reduced=$(reduce_workflow) || fail 'workflow-v1 is invalid'
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -z "$active_claim" ] || fail 'one action is already claimed'
  ready_obligation=$(printf '%s\n' "$reduced" | awk -F '\t' '$2 == "READY" { print $1; exit }')
  [ "$obligation_id" = "$ready_obligation" ] || fail "obligation is not the selected ready action: $obligation_id"

  local sequence nonce_basename dispatch_digest receipt_file receipt_digest metadata_file event_id
  sequence=$(next_sequence)
  nonce_basename="nonce-$$_$RANDOM"
  dispatch_digest=$(sha256_file "$dispatch_file")
  receipt_file=$(mktemp)
  {
    printf '%s\n' 'workflow-format: 1'
    printf 'obligation-id: %s\n' "$obligation_id"
    printf 'claim-revision: %s\n' "$sequence"
    printf 'actor: %s\n' "$actor"
    printf 'dispatch-sha256: %s\n' "$dispatch_digest"
    printf 'nonce-path: %s\n' "$nonce_basename"
  } >"$receipt_file"
  receipt_digest=$(sha256_file "$receipt_file")
  metadata_file=$(mktemp)
  {
    printf 'claim-revision\t%s\n' "$sequence"
    printf 'dispatch-sha256\t%s\n' "$dispatch_digest"
    printf 'nonce-path\t%s\n' "$nonce_basename"
    printf 'receipt-sha256\t%s\n' "$receipt_digest"
  } >"$metadata_file"
  event_id=$(append_staged_event "$obligation_id" CLAIM "$actor" "GDD-R$receipt_digest" "$dispatch_file" dispatch "$metadata_file" "$receipt_file") || {
    rm -f "$receipt_file" "$metadata_file"
    return 75
  }
  rm -f "$receipt_file" "$metadata_file"
  printf 'Event ID: %s\nReceipt: GDD-R%s\n' "$event_id" "$receipt_digest"
}

accept_action() {
  local receipt=$1
  local result_kind=$2
  local evidence_file=$3
  shift 3
  [ -f "$evidence_file" ] || fail "result evidence is missing: $evidence_file"
  scalar_value "$receipt"
  scalar_value "$result_kind"
  local accepted_event_id evidence_digest existing_path metadata_file existing_result_kind existing_digest
  evidence_digest=$(sha256_file "$evidence_file")
  accepted_event_id=$(accepted_event_for_receipt "$receipt")
  if [ -n "$accepted_event_id" ]; then
    existing_path=$(event_path_for_id "$accepted_event_id")
    metadata_file="$workflow/$(dirname "$existing_path")/metadata.tsv"
    existing_result_kind=$(metadata_value "$metadata_file" result-kind)
    existing_digest=$(metadata_value "$metadata_file" result-sha256)
    if [ "$existing_result_kind" = "$result_kind" ] && [ "$existing_digest" = "$evidence_digest" ]; then
      printf 'Event ID: %s\n' "$accepted_event_id"
      return
    fi
    local rejection_digest
    rejection_digest=$(sha256_values "$receipt" "$result_kind" "$evidence_digest")
    cp "$evidence_file" "$workflow/rejections/rejection-$rejection_digest"
    printf 'Accepted event ID: %s\n' "$accepted_event_id" >&2
    return 1
  fi

  local active_claim obligation_id actor active_receipt claim_revision event_id metadata_temp
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -n "$active_claim" ] || fail 'receipt does not match the active claim'
  IFS=$'\t' read -r obligation_id actor active_receipt claim_revision event_id <<<"$active_claim"
  [ "$receipt" = "$active_receipt" ] || fail 'receipt does not match the active claim'
  obligation_allowed_result "$obligation_id" "$result_kind" || fail "result kind $result_kind is not allowed for $obligation_id"
  [ "$(current_revision)" = "$claim_revision" ] || fail 'receipt claim revision is stale'
  metadata_temp=$(mktemp)
  {
    printf 'result-kind\t%s\n' "$result_kind"
    printf 'result-sha256\t%s\n' "$evidence_digest"
    printf 'claim-revision\t%s\n' "$claim_revision"
    printf 'claim-actor\t%s\n' "$actor"
  } >"$metadata_temp"
  event_id=$(append_staged_event "$obligation_id" ACCEPT "$actor" "$receipt" "$evidence_file" result "$metadata_temp" "$@") || {
    rm -f "$metadata_temp"
    return 75
  }
  rm -f "$metadata_temp"
  emit_repair_invalidations "$obligation_id" "$actor" "$receipt" "$evidence_file" "$event_id" || return 75
  printf 'Event ID: %s\n' "$event_id"
}

release_action() {
  local receipt=$1
  local evidence_file=$2
  [ -f "$evidence_file" ] || fail "release evidence is missing: $evidence_file"
  grep -qxF 'Status: DISPATCH_FAILED' "$evidence_file" || fail 'release evidence must contain Status: DISPATCH_FAILED'
  local active_claim obligation_id actor active_receipt claim_revision event_id metadata_temp released_event_id
  released_event_id=$(released_event_for_receipt "$receipt")
  if [ -n "$released_event_id" ]; then
    printf 'Event ID: %s\n' "$released_event_id"
    return
  fi
  active_claim=$(active_claim_record) || fail 'workflow-v1 is invalid'
  [ -n "$active_claim" ] || fail 'receipt does not match the active claim'
  IFS=$'\t' read -r obligation_id actor active_receipt claim_revision event_id <<<"$active_claim"
  [ "$receipt" = "$active_receipt" ] || fail 'receipt does not match the active claim'
  metadata_temp=$(mktemp)
  printf 'release-reason\tDISPATCH_FAILED\n' >"$metadata_temp"
  event_id=$(append_staged_event "$obligation_id" RELEASE "$actor" "$receipt" "$evidence_file" release "$metadata_temp") || {
    rm -f "$metadata_temp"
    return 75
  }
  rm -f "$metadata_temp"
  printf 'Event ID: %s\n' "$event_id"
}

[ $# -ge 2 ] || usage
plan=$1
command=$2
shift 2
script_dir="$(cd "$(dirname "$0")" && pwd)"
finding_policy="$script_dir/../finding-policy.md"
workspace=''
workflow=''
tasks_file=''

case "$command" in
  init)
    [ $# -eq 0 ] || usage
    require_plan
    initialize_workflow
    ;;
  status)
    [ $# -eq 0 ] || usage
    require_plan
    require_workflow
    run_locked print_status || fail 'workflow-v1 is invalid'
    ;;
  next)
    [ $# -eq 0 ] || usage
    require_plan
    require_workflow
    run_locked select_next || fail 'workflow-v1 is invalid'
    ;;
  format-version)
    [ $# -eq 0 ] || usage
    require_plan
    require_workflow
    printf '%s\n' 1
    ;;
  claim)
    [ $# -eq 3 ] || usage
    require_plan
    require_workflow
    run_locked claim_action "$1" "$2" "$3"
    ;;
  accept)
    [ $# -ge 3 ] || usage
    require_plan
    require_workflow
    run_locked accept_action "$@"
    ;;
  release)
    [ $# -eq 2 ] || usage
    require_plan
    require_workflow
    run_locked release_action "$1" "$2"
    ;;
  accept-active|project|digest|complete)
    printf 'gdd-workflow-state: %s is not available in the initialization skeleton\n' "$command" >&2
    exit 1
    ;;
  *) usage ;;
esac
