#!/usr/bin/env bash
# Record and validate lifecycle findings separately from GDD slice state.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
readonly SCRIPT_DIR
readonly LIFECYCLE_STATES='REPORTED REPAIRING RESOLVED DEFERRED DISMISSED PARKED BLOCKED'
readonly FINDING_FIELDS='Origin role|Severity claim|Blocking claim|Observed failure|Evidence|Violated authority|Assumptions|Failure scenario|Proposed repair|Repair effects'
readonly CONSULT_FIELDS='Finding IDs|Case|Problem|Verdict|Recommendation|Basis|Risks and assumptions|Flip condition|Forward consult gates|Decision|Reason|Cost if wrong|Controller action'

usage() {
  cat >&2 <<'EOF'
usage:
  gdd-finding-state PLAN_FILE init
  gdd-finding-state PLAN_FILE report SCOPE ORIGIN ROLE_REPORT FINDINGS_DIR [FINAL_SUITE_REPORT]
  gdd-finding-state PLAN_FILE supplement FINDING_ID REPORT_FILE
  gdd-finding-state PLAN_FILE transition FINDING_ID STATE EVIDENCE_FILE
  gdd-finding-state PLAN_FILE consult FINDING_ID CONSULT_FILE
  gdd-finding-state PLAN_FILE repair-start FINDING_ID EVIDENCE_FILE
  gdd-finding-state PLAN_FILE repair-result FINDING_ID FIXER_REPORT
  gdd-finding-state PLAN_FILE repair-finish FINDING_ID EVIDENCE_FILE
  gdd-finding-state PLAN_FILE guard SLICE TARGET_STATE
  gdd-finding-state PLAN_FILE digest OUTPUT_FILE
EOF
  exit 2
}

fail() {
  printf 'gdd-finding-state: %s\n' "$1" >&2
  exit 1
}

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

resolve_workspace_path() {
  plan_path=$1
  [ -f "$plan_path" ] || fail "no such plan file: $plan_path"
  plan_dir=$(cd "$(dirname "$plan_path")" && pwd)
  slug=$(basename "$plan_path" .md)
  if [ "$slug" = 'plan' ]; then
    slug=$(basename "$plan_dir")
  fi
  [ -n "$slug" ] && [ "$slug" != '.' ] && [ "$slug" != '..' ] \
    || fail "cannot derive a workspace name from: $plan_path"
  repo_root=$(git -C "$plan_dir" rev-parse --show-toplevel 2>/dev/null) \
    || fail "plan file is not inside a Git work tree: $plan_path"
  printf '%s/.superpowers/gdd/%s\n' "$repo_root" "$slug"
}

require_workspace() {
  [ -d "$workspace" ] || fail "finding workspace is not initialized: $workspace"
  [ -f "$ledger" ] || fail "finding ledger is not initialized: $ledger"
  [ -d "$findings_dir" ] || fail "finding artifact directory is not initialized: $findings_dir"
}

validate_scope_origin() {
  scope=$1
  origin=$2
  case "$origin" in
    'Task Reviewer'|Re-reviewer|Cleaner|Architect|Hardener|QA|'Branch Reviewer'|'Security Reviewer') ;;
    *) fail "unknown finding origin: $origin" ;;
  esac
  if [ "$scope" = feature ]; then
    case "$origin" in
      'Branch Reviewer'|'Security Reviewer') ;;
      *) fail "feature findings must originate from Branch Reviewer or Security Reviewer: $origin" ;;
    esac
    return
  fi
  case "$scope" in ''|*[!0-9]*|0) fail "finding scope must be a positive slice number or feature: $scope" ;; esac
  case "$origin" in 'Branch Reviewer'|'Security Reviewer') fail "$origin findings must use feature scope" ;; esac
}

require_readable_file() {
  [ -s "$1" ] || fail "$2 is missing or empty: $1"
}

field_count() {
  field=$1
  source_file=$2
  awk -v field="$field" '
    index($0, field ":") == 1 { count++ }
    END { print count + 0 }
  ' "$source_file"
}

field_value() {
  field=$1
  source_file=$2
  sed -n "s/^${field}: //p" "$source_file" | sed -n '1p'
}

is_known_finding_field() {
  case "$1" in
    'Origin role'|'Severity claim'|'Blocking claim'|'Observed failure'|'Evidence'|'Violated authority'|'Assumptions'|'Failure scenario'|'Proposed repair'|'Repair effects') return 0 ;;
    *) return 1 ;;
  esac
}

validate_report_shape() {
  report_file=$1
  expected_origin=$2
  complete_required=$3
  require_readable_file "$report_file" 'finding report'

  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    case "$line" in
      *': '*) label=${line%%: *}; value=${line#*: } ;;
      *) fail "unknown finding report field: $line" ;;
    esac
    is_known_finding_field "$label" || fail "unknown finding report field: $label"
    [ -n "$value" ] || fail "finding report field is empty: $label"
  done <"$report_file"

  for field in ${FINDING_FIELDS//|/ }; do
    :
  done
  while IFS='|' read -r -d '|' field; do
    count=$(field_count "$field" "$report_file")
    [ "$count" -le 1 ] || fail "duplicate finding report field: $field"
    if [ "$complete_required" = yes ]; then
      [ "$count" -eq 1 ] || fail "missing finding report field: $field"
      value=$(field_value "$field" "$report_file")
      case "$value" in
        'N/A: '?*) ;;
        N/A:*) fail "N/A finding report field needs a controller-verified reason: $field" ;;
      esac
    fi
  done < <(printf '%s|' "$FINDING_FIELDS")

  origin_count=$(field_count 'Origin role' "$report_file")
  [ "$origin_count" -eq 1 ] || fail 'finding report must contain exactly one Origin role'
  origin_value=$(field_value 'Origin role' "$report_file")
  [ "$origin_value" = "$expected_origin" ] \
    || fail "finding report Origin role does not match origin argument: $expected_origin"
}

finding_row() {
  finding_id=$1
  awk -F '\t' -v id="$finding_id" '$1 == id { print }' "$ledger"
}

require_finding() {
  local finding_id=$1
  case "$finding_id" in GDD-F[0-9][0-9][0-9][0-9]) ;; *) fail "invalid finding ID: $finding_id" ;; esac
  finding_row "$finding_id" | grep -q . || fail "unknown finding ID: $finding_id"
}

latest_lifecycle_state() {
  finding_id=$1
  awk -F '\t' -v id="$finding_id" '
    $1 == id && ($4 == "REPORTED" || $4 == "REPAIRING" || $4 == "RESOLVED" || $4 == "DEFERRED" || $4 == "DISMISSED" || $4 == "PARKED" || $4 == "BLOCKED") { state=$4 }
    END { print state }
  ' "$ledger"
}

finding_scope() {
  finding_id=$1
  awk -F '\t' -v id="$finding_id" '$1 == id { print $2; exit }' "$ledger"
}

finding_origin() {
  finding_id=$1
  awk -F '\t' -v id="$finding_id" '$1 == id { print $3; exit }' "$ledger"
}

event_evidence() {
  artifact_path=$1
  printf '%s/%s/evidence.md\n' "$workspace" "$artifact_path"
}

latest_event_evidence() {
  finding_id=$1
  event_prefix=$2
  find "$findings_dir/$finding_id/events" -mindepth 1 -maxdepth 1 -type d -name "*-$event_prefix" -print 2>/dev/null | sort | tail -1 | \
    sed 's#$#/evidence.md#'
}

report_is_complete() {
  finding_id=$1
  origin=$(finding_origin "$finding_id")
  latest_supplement=$(latest_event_evidence "$finding_id" supplement)
  if [ -n "$latest_supplement" ] && [ -s "$latest_supplement" ]; then
    validate_report_shape "$latest_supplement" "$origin" yes
    return
  fi
  first_report=$(latest_event_evidence "$finding_id" report)
  validate_report_shape "$first_report" "$origin" yes
}

require_complete_report() {
  finding_id=$1
  if ! report_is_complete "$finding_id"; then
    fail "finding cannot leave REPORTED until its report is complete: $finding_id"
  fi
}

validate_replay_origin() {
  case "$1" in
    re-review|downstream) ;;
    *) fail "Replay through must be re-review or downstream: $1" ;;
  esac
}

terminal_decision_authorizes() {
  local decision=$1 target_state=$2
  case "$decision:$target_state" in
    NO_FIX:DISMISSED|PARK:PARKED|ESCALATE:BLOCKED|\
    USER\:NO_FIX:DISMISSED|USER\:PARK:PARKED) return 0 ;;
    *) fail "consultation decision $decision does not authorize $target_state" ;;
  esac
}

recorded_consult_decision() {
  local finding_id=$1 supplied_file=$2 supplied_digest consult_dir consult_file
  supplied_digest=$(sha256_file "$supplied_file")
  while IFS= read -r consult_dir; do
    consult_file="$consult_dir/evidence.md"
    [ -s "$consult_file" ] || continue
    [ "$(sha256_file "$consult_file")" = "$supplied_digest" ] || continue
    validate_consult_file "$finding_id" "$consult_file"
    field_value Decision "$consult_file"
    return
  done < <(find "$findings_dir/$finding_id/events" -mindepth 1 -maxdepth 1 -type d -name '*-consult-*' -print 2>/dev/null | sort)
  fail "Fable result is not a recorded consultation for $finding_id"
}

user_authority_decision() {
  local authority_file=$1 decision
  [ "$(field_count Decision "$authority_file")" -eq 1 ] \
    || fail 'User authority must contain exactly one Decision'
  decision=$(field_value Decision "$authority_file")
  case "$decision" in
    USER:NO_FIX|USER:PARK) printf '%s\n' "$decision" ;;
    *) fail 'User authority Decision must be USER:NO_FIX or USER:PARK' ;;
  esac
}

validate_transition_evidence() {
  finding_id=$1
  target_state=$2
  evidence_file=$3
  require_readable_file "$evidence_file" 'transition evidence'
  scope=$(finding_scope "$finding_id")
  case "$target_state" in
    REPAIRING)
      require_complete_report "$finding_id"
      hypothesis=$(field_value 'Repair hypothesis' "$evidence_file")
      repair_base=$(field_value 'Repair base' "$evidence_file")
      replay_through=$(field_value 'Replay through' "$evidence_file")
      [ -n "$hypothesis" ] || fail 'REPAIRING requires Repair hypothesis'
      [ -n "$repair_base" ] || fail 'REPAIRING requires Repair base'
      git -C "$repo_root" cat-file -e "$repair_base^{commit}" 2>/dev/null \
        || fail "Repair base is not an existing commit: $repair_base"
      validate_replay_origin "$replay_through"
      if [ "$replay_through" = downstream ]; then
        case "$(finding_origin "$finding_id")" in
          Cleaner|Architect|Hardener|QA) ;;
          *) fail 'Replay through: downstream requires a Cleaner, Architect, Hardener, or QA finding' ;;
        esac
      fi
      ;;
    DEFERRED|DISMISSED|PARKED|BLOCKED)
      require_complete_report "$finding_id"
      [ "$(field_value Disposition "$evidence_file")" = "$target_state" ] \
        || fail "$target_state requires matching Disposition"
      for terminal_field in Ruling 'Cost if wrong' 'Wake condition'; do
        [ -n "$(field_value "$terminal_field" "$evidence_file")" ] \
          || fail "$target_state requires $terminal_field"
      done
      if [ "$target_state" != DEFERRED ]; then
        fable_value=$(field_value 'Fable result' "$evidence_file")
        [ -n "$fable_value" ] || fail "$target_state requires Fable result"
        case "$fable_value" in
          'UNAVAILABLE: '?*)
            if [ "$target_state" != BLOCKED ]; then
              user_authority=$(field_value 'User authority' "$evidence_file")
              [ -n "$user_authority" ] || fail "$target_state without Fable requires User authority"
              require_readable_file "$user_authority" 'User authority'
              terminal_decision_authorizes "$(user_authority_decision "$user_authority")" "$target_state"
            fi
            ;;
          UNAVAILABLE:*) fail 'Fable result UNAVAILABLE needs a reason' ;;
          *)
            require_readable_file "$fable_value" 'Fable result'
            terminal_decision_authorizes "$(recorded_consult_decision "$finding_id" "$fable_value")" "$target_state"
            ;;
        esac
      fi
      if [ "$target_state" = BLOCKED ]; then
        blocking_boundary=$(field_value 'Blocked boundary' "$evidence_file")
        [ -n "$blocking_boundary" ] || fail 'BLOCKED requires Blocked boundary'
        awk -F '\t' -v expected="$blocking_boundary" 'NR > 1 && $1 == expected { found=1 } END { exit !found }' "$workspace/workflow-v1/obligations.tsv" \
          || fail "Blocked boundary is not a static lifecycle obligation: $blocking_boundary"
      fi
      ;;
    RESOLVED)
      latest_finish=$(latest_event_evidence "$finding_id" repair-finish)
      [ -s "$latest_finish" ] || fail 'RESOLVED requires a completed repair attempt'
      [ "$(field_value 'Replay status' "$latest_finish")" = VERIFIED ] \
        || fail 'RESOLVED requires the latest repair replay to be VERIFIED'
      replay_copy="$(dirname "$latest_finish")/supporting-evidence.md"
      [ -s "$replay_copy" ] || fail 'RESOLVED requires an immutable replay evidence copy'
      ;;
    REPORTED)
      require_nonempty=$(field_value 'Wake evidence' "$evidence_file")
      [ -n "$require_nonempty" ] || fail 'wake transition requires Wake evidence'
      ;;
  esac
}

validate_transition() {
  finding_id=$1
  target_state=$2
  current_state=$(latest_lifecycle_state "$finding_id")
  case "$current_state -> $target_state" in
    'REPORTED -> REPAIRING'|\
    'REPORTED -> DEFERRED'|\
    'REPORTED -> DISMISSED'|\
    'REPORTED -> PARKED'|\
    'REPORTED -> BLOCKED'|\
    'REPAIRING -> RESOLVED'|\
    'REPAIRING -> DEFERRED'|\
    'REPAIRING -> DISMISSED'|\
    'REPAIRING -> PARKED'|\
    'REPAIRING -> BLOCKED'|\
    'DEFERRED -> REPORTED'|\
    'DISMISSED -> REPORTED'|\
    'PARKED -> REPORTED'|\
    'BLOCKED -> REPORTED') ;;
    *) fail "illegal finding transition: $current_state -> $target_state" ;;
  esac
}

latest_repair_start() {
  latest_event_evidence "$1" repair-start
}

latest_repair_finish() {
  latest_event_evidence "$1" repair-finish
}

repair_event_for_round() {
  finding_id=$1
  event_name=$2
  requested_round=$3
  for event_directory in $(find "$findings_dir/$finding_id/events" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort); do
    [ "$(cat "$event_directory/kind")" = "$event_name" ] || continue
    [ "$(field_value 'Repair round' "$event_directory/evidence.md")" = "$requested_round" ] || continue
    printf '%s\n' "$event_directory/evidence.md"
    return
  done
}

scope_finding_ids() {
  awk -F '\t' -v expected_scope="$1" '$2 == expected_scope { seen[$1] = 1 } END { for (id in seen) print id }' "$ledger" | sort
}

scope_max_round() {
  local scope=$1 other_id round max_round=0
  for other_id in $(scope_finding_ids "$scope"); do
    for round in 1 2 3 4 5; do
      [ -n "$(repair_event_for_round "$other_id" repair-start "$round")" ] || continue
      [ "$round" -le "$max_round" ] || max_round=$round
    done
  done
  printf '%s\n' "$max_round"
}

scope_round_is_open() {
  local scope=$1 round=$2 other_id
  for other_id in $(scope_finding_ids "$scope"); do
    [ -n "$(repair_event_for_round "$other_id" repair-start "$round")" ] || continue
    [ -n "$(repair_event_for_round "$other_id" repair-finish "$round")" ] || return 0
  done
  return 1
}

scope_next_round() {
  local scope=$1 max_round
  max_round=$(scope_max_round "$scope")
  if [ "$max_round" -gt 0 ] && scope_round_is_open "$scope" "$max_round"; then
    printf '%s\n' "$max_round"
  else
    printf '%s\n' $((max_round + 1))
  fi
}

event_metadata_value() {
  local event_id=$1 key=$2
  awk -F '\t' -v expected_key="$key" '$1 == expected_key { print $2; exit }' \
    "$workspace/workflow-v1/events/$event_id/metadata.tsv"
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  else
    sha256sum "$1" | awk '{ print $1 }'
  fi
}

current_repair_accepted_sequence() {
  local finding_id=$1 repair_round=$2 sequence event_id event_kind metadata_round
  local accepted_sequence=''
  while IFS=$'\t' read -r sequence _revision event_id _obligation_id event_kind _actor _receipt _evidence_path _evidence_sha256 _previous_hash _event_hash; do
    [ "$event_kind" = ACCEPT ] || continue
    [ "$(event_metadata_value "$event_id" result-kind)" = RepairAccepted ] || continue
    [ "$(event_metadata_value "$event_id" finding-id)" = "$finding_id" ] || continue
    metadata_round=$(event_metadata_value "$event_id" repair-round)
    [ "$metadata_round" = "$repair_round" ] || continue
    accepted_sequence=$sequence
  done <"$workspace/workflow-v1/events.tsv"
  [ -n "$accepted_sequence" ] || fail "repair-finish requires an accepted repair result for round $repair_round"
  printf '%s\n' "$accepted_sequence"
}

worker_position() {
  case "$1" in
    cleaner) printf '1\n' ;;
    architect) printf '2\n' ;;
    hardener) printf '3\n' ;;
    qa) printf '4\n' ;;
    *) printf '0\n' ;;
  esac
}

canonical_replay_evidence_digest() {
  local finding_id=$1 repair_round=$2 accepted_sequence replay_through scope origin owner
  local sequence event_id obligation_id event_kind evidence_sha256 result_kind worker
  accepted_sequence=$(current_repair_accepted_sequence "$finding_id" "$repair_round")
  replay_through=$(field_value 'Replay through' "$(latest_event_evidence "$finding_id" transition-repairing)")
  scope=$(finding_scope "$finding_id")
  origin=$(finding_origin "$finding_id")
  case "$replay_through" in
    re-review)
      owner=$(origin_obligation_id "$scope" "$origin")
      case "$owner" in *-review) ;; *) fail "repair-finish has no review owner for $finding_id" ;; esac
      while IFS=$'\t' read -r sequence _revision event_id obligation_id event_kind _actor _receipt _evidence_path evidence_sha256 _previous_hash _event_hash; do
        [ "$event_kind" = ACCEPT ] || continue
        [ "$obligation_id" = "$owner" ] || continue
        [ "$sequence" -gt "$accepted_sequence" ] || continue
        printf '%s\n' "$evidence_sha256"
        return
      done <"$workspace/workflow-v1/events.tsv"
      fail "repair-finish requires accepted re-review evidence for $owner"
      ;;
    downstream)
      while IFS=$'\t' read -r sequence _revision event_id obligation_id event_kind _actor _receipt _evidence_path evidence_sha256 _previous_hash _event_hash; do
        [ "$event_kind" = ACCEPT ] || continue
        [ "$sequence" -gt "$accepted_sequence" ] || continue
        case "$obligation_id" in "slice-$scope-"cleaner|"slice-$scope-"architect|"slice-$scope-"hardener|"slice-$scope-"qa) ;; *) continue ;; esac
        worker=${obligation_id##*-}
        [ "$(worker_position "$worker")" -ge "$(worker_position "$(lowercase "$origin")")" ] || continue
        result_kind=$(event_metadata_value "$event_id" result-kind)
        [ "$result_kind" != FAIL ] || continue
        printf '%s\n' "$evidence_sha256"
        return
      done <"$workspace/workflow-v1/events.tsv"
      fail "repair-finish requires accepted downstream evidence for $finding_id"
      ;;
    *) fail "repair-finish has an invalid Replay through value: $replay_through" ;;
  esac
}

validate_repair_start() {
  finding_id=$1
  evidence_file=$2
  [ "$(latest_lifecycle_state "$finding_id")" = REPAIRING ] \
    || fail 'repair-start requires a REPAIRING finding'
  require_readable_file "$evidence_file" 'repair-start evidence'
  scope=$(finding_scope "$finding_id")
  origin=$(finding_origin "$finding_id")
  round=$(field_value 'Repair round' "$evidence_file")
  executor=$(field_value Executor "$evidence_file")
  agent_id=$(field_value 'Agent ID' "$evidence_file")
  hypothesis=$(field_value 'Repair hypothesis' "$evidence_file")
  expected_round=$(scope_next_round "$scope")
  if [ "$scope" = feature ]; then
    [ "$expected_round" -le 1 ] || fail 'feature round cap reached'
  else
    [ "$expected_round" -le 5 ] || fail 'slice round cap reached'
  fi
  [ "$round" = "$expected_round" ] || fail "Repair round must be $expected_round for scope $scope: $round"
  [ -n "$agent_id" ] || fail 'repair-start requires Agent ID'
  [ -n "$hypothesis" ] || fail 'repair-start requires Repair hypothesis'
  [ "$executor" = fixer-max ] || fail "repair-start requires Executor: fixer-max: $executor"
  previous_start=$(latest_repair_start "$finding_id")
  if [ -s "$previous_start" ]; then
    previous_round=$(field_value 'Repair round' "$previous_start")
    [ "$round" -gt "$previous_round" ] || fail 'Repair round must exceed the previous round of this finding'
    previous_finish=$(repair_event_for_round "$finding_id" repair-finish "$previous_round")
    [ -n "$previous_finish" ] && [ -s "$previous_finish" ] \
      || fail 'a new repair round requires the prior repair-finish'
    [ "$(field_value 'Replay status' "$previous_finish")" = FAILED ] \
      || fail 'a new repair round requires the prior repair-finish to be FAILED'
    if [ "$hypothesis" = "$(field_value 'Repair hypothesis' "$previous_start")" ]; then
      falsifying_file=$(field_value 'Falsifying evidence' "$evidence_file")
      require_readable_file "$falsifying_file" 'Falsifying evidence'
      [ -n "$(field_value 'Falsifies prior hypothesis' "$evidence_file")" ] \
        || fail 'an unchanged Repair hypothesis requires Falsifies prior hypothesis'
    fi
  fi
  if find "$findings_dir/$finding_id/events" -name evidence.md -type f -print0 2>/dev/null | xargs -0 grep -Fqx "Agent ID: $agent_id" 2>/dev/null; then
    fail "Agent ID was already used for finding $finding_id: $agent_id"
  fi
}

validate_repair_finish() {
  finding_id=$1
  evidence_file=$2
  [ "$(latest_lifecycle_state "$finding_id")" = REPAIRING ] \
    || fail 'repair-finish requires a REPAIRING finding'
  require_readable_file "$evidence_file" 'repair-finish evidence'
  start_file=$(latest_repair_start "$finding_id")
  [ -s "$start_file" ] || fail 'repair-finish requires a repair-start'
  for repair_field in 'Repair round' Executor 'Agent ID'; do
    [ "$(field_value "$repair_field" "$evidence_file")" = "$(field_value "$repair_field" "$start_file")" ] \
      || fail "repair-finish does not match repair-start field: $repair_field"
  done
  round=$(field_value 'Repair round' "$evidence_file")
  existing_finish=$(repair_event_for_round "$finding_id" repair-finish "$round")
  [ -z "$existing_finish" ] || fail "repair-finish already exists for repair round $round"
  repair_base=$(latest_event_evidence "$finding_id" transition-repairing)
  repair_base=$(field_value 'Repair base' "$repair_base")
  repair_head=$(field_value 'Repair head' "$evidence_file")
  git -C "$repo_root" cat-file -e "$repair_head^{commit}" 2>/dev/null \
    || fail "Repair head is not an existing commit: $repair_head"
  git -C "$repo_root" merge-base --is-ancestor "$repair_base" "$repair_head" \
    || fail 'Repair head must descend from Repair base'
  case "$(field_value 'Replay status' "$evidence_file")" in FAILED|VERIFIED) ;; *) fail 'repair-finish requires Replay status FAILED or VERIFIED' ;; esac
  replay_evidence=$(field_value 'Replay evidence' "$evidence_file")
  require_readable_file "$replay_evidence" 'Replay evidence'
  expected_digest=$(canonical_replay_evidence_digest "$finding_id" "$round")
  [ "$(sha256_file "$replay_evidence")" = "$expected_digest" ] \
    || fail 'Replay evidence does not match the accepted replay report'
}

active_obligation() {
  "$SCRIPT_DIR/gdd-workflow-state" "$plan" status | sed -n 's/^Active claim: //p'
}

report_shape_is_complete() {
  local report_file=$1
  local field count value
  while IFS='|' read -r -d '|' field; do
    count=$(field_count "$field" "$report_file")
    [ "$count" -eq 1 ] || return 1
    value=$(field_value "$field" "$report_file")
    [ -n "$value" ] || return 1
    case "$value" in N/A:*)
      case "$value" in 'N/A: '?*) ;; *) return 1 ;; esac
      ;;
    esac
  done < <(printf '%s|' "$FINDING_FIELDS")
}

accept_finding_result() {
  local finding_id=$1
  local result_kind=$2
  local evidence_file=$3
  shift 3
  local obligation
  obligation=$(active_obligation)
  case "$obligation" in
    finding-"$finding_id"-*) ;;
    *) fail "active claim does not authorize finding $finding_id: $obligation" ;;
  esac
  GDD_FINDING_ID="$finding_id" \
  GDD_FINDING_SCOPE="$(finding_scope "$finding_id")" \
  GDD_FINDING_ORIGIN="$(finding_origin "$finding_id")" \
  GDD_FINDING_STATE="${GDD_FINDING_STATE:-$(latest_lifecycle_state "$finding_id")}" \
  GDD_FINDING_EVENT_NAME="${GDD_FINDING_EVENT_NAME:-event}" \
  GDD_REPAIR_ROUND="${GDD_REPAIR_ROUND:-}" \
  GDD_REPLAY_STATUS="${GDD_REPLAY_STATUS:-}" \
  GDD_REPLAY_THROUGH="${GDD_REPLAY_THROUGH:-}" \
  GDD_BLOCKING_BOUNDARY="${GDD_BLOCKING_BOUNDARY:-}" \
    "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" "$result_kind" "$evidence_file" "$@" >/dev/null
}

command_init() {
  [ $# -eq 0 ] || usage
  "$SCRIPT_DIR/gdd-workflow-state" "$plan" init >/dev/null
}

review_owns_origin() {
  case "$1:$2" in
    'Task Reviewer:Task Reviewer'|'Task Reviewer:Re-reviewer'|'Re-reviewer:Task Reviewer'|'Re-reviewer:Re-reviewer') return 0 ;;
    'Branch Reviewer:Branch Reviewer'|'Security Reviewer:Security Reviewer') return 0 ;;
    *) return 1 ;;
  esac
}

review_result_kind() {
  local scope=$1 origin=$2 role_findings_dir=$3 finding_file severity other_id
  for finding_file in "$role_findings_dir"/*.md; do
    [ -f "$finding_file" ] || continue
    severity=$(field_value 'Severity claim' "$finding_file")
    case "$origin:$severity" in
      'Branch Reviewer:'*|'Security Reviewer:'*) printf 'FAIL\n'; return ;;
      *:Critical|*:Important) printf 'FAIL\n'; return ;;
    esac
  done
  for other_id in $(scope_finding_ids "$scope"); do
    review_owns_origin "$origin" "$(finding_origin "$other_id")" || continue
    case "$(latest_lifecycle_state "$other_id")" in
      REPORTED|REPAIRING) printf 'FAIL\n'; return ;;
    esac
  done
  printf 'PASS\n'
}

command_report() {
  [ $# -eq 4 ] || [ $# -eq 5 ] || usage
  scope=$1
  origin=$2
  role_report=$3
  role_findings_dir=$4
  final_suite_report=${5:-}
  validate_scope_origin "$scope" "$origin"
  require_workspace
  obligation=$(active_obligation)
  expected_obligation=$(origin_obligation_id "$scope" "$origin")
  [ "$obligation" = "$expected_obligation" ] \
    || fail "report requires active obligation $expected_obligation: $obligation"
  existing_ids=" $(awk -F '\t' -v expected_scope="$scope" -v expected_origin="$origin" \
    '$2 == expected_scope && $3 == expected_origin { printf "%s ", $1 }' "$ledger")"
  role_status=$(field_value Status "$role_report")
  case "$origin" in
    'Task Reviewer'|Re-reviewer|'Branch Reviewer'|'Security Reviewer')
      [ -z "$final_suite_report" ] || usage
      result_kind=$(review_result_kind "$scope" "$origin" "$role_findings_dir")
      GDD_FINDINGS_DIR="$role_findings_dir" \
        "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" "$result_kind" "$role_report" >/dev/null
      ;;
    QA)
      case "$role_status" in
        VERIFIED)
          [ -n "$final_suite_report" ] || usage
          GDD_FINDINGS_DIR="$role_findings_dir" "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" SliceVerifiedMacro "$role_report" "$final_suite_report" >/dev/null
          ;;
        'NOT VERIFIED')
          GDD_FINDINGS_DIR="$role_findings_dir" "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" FAIL "$role_report" >/dev/null
          ;;
        *) fail 'QA report must contain Status: VERIFIED or Status: NOT VERIFIED' ;;
      esac
      ;;
    Hardener)
      case "$role_status" in
        VERIFIED) GDD_FINDINGS_DIR="$role_findings_dir" "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" PASS "$role_report" >/dev/null ;;
        'NOT VERIFIED'|REVERIFY_REQUIRED) GDD_FINDINGS_DIR="$role_findings_dir" "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" FAIL "$role_report" >/dev/null ;;
        *) fail 'Hardener report must contain Status: VERIFIED, NOT VERIFIED, or REVERIFY_REQUIRED' ;;
      esac
      ;;
    *) GDD_FINDINGS_DIR="$role_findings_dir" "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" PASS "$role_report" >/dev/null ;;
  esac
  awk -F '\t' -v expected_scope="$scope" -v expected_origin="$origin" \
    '$2 == expected_scope && $3 == expected_origin { print $1 }' "$ledger" | \
    while IFS= read -r finding_id; do
      case "$existing_ids" in *" $finding_id "*) ;; *) printf '%s\n' "$finding_id" ;; esac
    done
}

origin_obligation_id() {
  local scope=$1
  local origin=$2
  case "$origin" in
    'Branch Reviewer') printf 'feature-branch-review\n' ;;
    'Security Reviewer') printf 'feature-security-review\n' ;;
    'Task Reviewer'|Re-reviewer) printf 'slice-%s-review\n' "$scope" ;;
    Cleaner) printf 'slice-%s-cleaner\n' "$scope" ;;
    Architect) printf 'slice-%s-architect\n' "$scope" ;;
    Hardener) printf 'slice-%s-hardener\n' "$scope" ;;
    QA) printf 'slice-%s-qa\n' "$scope" ;;
    *) fail "unknown finding origin: $origin" ;;
  esac
}

command_supplement() {
  [ $# -eq 2 ] || usage
  finding_id=$1
  report_file=$2
  require_workspace
  require_readable_file "$report_file" 'finding report'
  require_finding "$finding_id"
  origin=$(finding_origin "$finding_id")
  validate_report_shape "$report_file" "$origin" yes
  GDD_FINDING_EVENT_NAME=supplement accept_finding_result "$finding_id" FindingSupplemented "$report_file"
}

command_transition() {
  [ $# -eq 3 ] || usage
  finding_id=$1
  target_state=$2
  evidence_file=$3
  require_workspace
  case " $LIFECYCLE_STATES " in *" $target_state "*) ;; *) fail "unknown finding state: $target_state" ;; esac
  require_readable_file "$evidence_file" 'transition evidence'
  require_finding "$finding_id"
  validate_transition "$finding_id" "$target_state"
  validate_transition_evidence "$finding_id" "$target_state" "$evidence_file"
  fable_file=''
  case "$target_state" in DEFERRED|DISMISSED|PARKED|BLOCKED)
    fable_value=$(field_value 'Fable result' "$evidence_file")
    case "$fable_value" in
      UNAVAILABLE:*) fable_file=$(field_value 'User authority' "$evidence_file") ;;
      *) fable_file=$fable_value ;;
    esac
  esac
  replay_through=''
  blocking_boundary=''
  result_kind=FindingDispositionRecorded
  [ "$target_state" != RESOLVED ] || result_kind=FindingResolved
  [ "$target_state" != REPAIRING ] || replay_through=$(field_value 'Replay through' "$evidence_file")
  [ "$target_state" != BLOCKED ] || blocking_boundary=$(field_value 'Blocked boundary' "$evidence_file")
  GDD_FINDING_STATE="$target_state" GDD_FINDING_EVENT_NAME="transition-$(lowercase "$target_state")" \
  GDD_REPLAY_THROUGH="$replay_through" GDD_BLOCKING_BOUNDARY="$blocking_boundary" \
    accept_finding_result "$finding_id" "$result_kind" "$evidence_file" ${fable_file:+"$fable_file"}
}

command_repair_start() {
  [ $# -eq 2 ] || usage
  finding_id=$1
  evidence_file=$2
  require_workspace
  require_readable_file "$evidence_file" 'repair-start evidence'
  require_finding "$finding_id"
  validate_repair_start "$finding_id" "$evidence_file"
  falsifying_file=$(field_value 'Falsifying evidence' "$evidence_file")
  GDD_FINDING_STATE=REPAIR_START GDD_FINDING_EVENT_NAME=repair-start GDD_REPAIR_ROUND="$(field_value 'Repair round' "$evidence_file")" \
    accept_finding_result "$finding_id" RepairStarted "$evidence_file" ${falsifying_file:+"$falsifying_file"}
}

command_repair_result() {
  [ $# -eq 2 ] || usage
  finding_id=$1
  fixer_report=$2
  require_workspace
  require_finding "$finding_id"
  require_readable_file "$fixer_report" 'fixer report'
  [ "$(latest_lifecycle_state "$finding_id")" = REPAIRING ] || fail 'repair-result requires a REPAIRING finding'
  start_file=$(latest_repair_start "$finding_id")
  [ -n "$start_file" ] && [ -s "$start_file" ] || fail 'repair-result requires a repair-start'
  round=$(field_value 'Repair round' "$start_file")
  [ -z "$(repair_event_for_round "$finding_id" repair-finish "$round")" ] || fail "repair round $round is already finished"
  replay_through=$(field_value 'Replay through' "$(latest_event_evidence "$finding_id" transition-repairing)")
  GDD_FINDING_STATE=REPAIR_RESULT GDD_FINDING_EVENT_NAME=repair-result GDD_REPAIR_ROUND="$round" GDD_REPLAY_THROUGH="$replay_through" \
    accept_finding_result "$finding_id" RepairAccepted "$fixer_report"
}

validate_consult_file() {
  local finding_id=$1 consult_file=$2 remaining field
  require_readable_file "$consult_file" 'consultation record'
  remaining="$CONSULT_FIELDS|"
  while [ -n "$remaining" ]; do
    field=${remaining%%|*}
    remaining=${remaining#*|}
    [ "$(field_count "$field" "$consult_file")" -eq 1 ] || fail "consultation record must contain exactly one $field"
    [ -n "$(field_value "$field" "$consult_file")" ] || fail "consultation record field is empty: $field"
  done
  case "$(field_value Case "$consult_file")" in C1|C2|C3|C4|C5) ;; *) fail 'Case must be C1, C2, C3, C4, or C5' ;; esac
  case "$(field_value Decision "$consult_file")" in
    FIX_NOW|NO_FIX|PARK|ESCALATE|USER:FIX_NOW|USER:NO_FIX|USER:PARK) ;;
    *) fail 'Decision must be FIX_NOW, NO_FIX, PARK, ESCALATE, USER:FIX_NOW, USER:NO_FIX, or USER:PARK' ;;
  esac
  case ",$(field_value 'Finding IDs' "$consult_file" | tr -d ' ')," in *",$finding_id,"*) ;; *) fail "Finding IDs does not include $finding_id" ;; esac
}

command_consult() {
  [ $# -eq 2 ] || usage
  finding_id=$1
  consult_file=$2
  require_workspace
  require_finding "$finding_id"
  validate_consult_file "$finding_id" "$consult_file"
  case "$(latest_lifecycle_state "$finding_id")" in REPORTED|REPAIRING) ;; *) fail "consult requires a REPORTED or REPAIRING finding: $finding_id" ;; esac
  obligation=$(active_obligation)
  case "$obligation" in "finding-$finding_id-consult-"[1-9]) ;; *) fail "consult requires an active consult claim for $finding_id: ${obligation:-none}" ;; esac
  GDD_FINDING_STATE=CONSULT GDD_FINDING_EVENT_NAME="consult-${obligation##*-consult-}" \
    accept_finding_result "$finding_id" FindingConsultRecorded "$consult_file"
}

command_repair_finish() {
  [ $# -eq 2 ] || usage
  finding_id=$1
  evidence_file=$2
  require_workspace
  require_readable_file "$evidence_file" 'repair-finish evidence'
  require_finding "$finding_id"
  validate_repair_finish "$finding_id" "$evidence_file"
  replay_file=$(field_value 'Replay evidence' "$evidence_file")
  GDD_FINDING_STATE=REPAIR_FINISH GDD_FINDING_EVENT_NAME=repair-finish GDD_REPAIR_ROUND="$(field_value 'Repair round' "$evidence_file")" GDD_REPLAY_STATUS="$(field_value 'Replay status' "$evidence_file")" \
    accept_finding_result "$finding_id" RepairFinished "$evidence_file" "$replay_file"
}

downstream_target() {
  local finding_id=$1 slice=$2 origin worker status
  origin=$(finding_origin "$finding_id")
  for worker in cleaner architect hardener qa; do
    case "$origin:$worker" in
      Architect:cleaner|Hardener:cleaner|Hardener:architect|QA:cleaner|QA:architect|QA:hardener) continue ;;
    esac
    status=$(awk -F '\t' -v obligation="slice-$slice-$worker" '$1 == obligation { print $2; exit }' "$status_file")
    [ "$status" != COMPLETE ] || continue
    case "$worker" in cleaner) printf 'verifying-architect\n' ;; architect) printf 'verifying-hardener\n' ;; hardener) printf 'verifying-qa\n' ;; qa) printf 'verified\n' ;; esac
    return
  done
  fail "finding $finding_id has no downstream worker left in slice $slice"
}

command_guard() {
  [ $# -eq 2 ] || usage
  slice=$1
  target=$2
  case "$slice" in ''|*[!0-9]*|0) fail "slice number must be a positive integer: $slice" ;; esac
  case "$target" in verifying-cleaner|verifying-architect|verifying-hardener|verifying-qa|verified) ;; *) fail "unknown lifecycle target: $target" ;; esac
  require_workspace
  "$SCRIPT_DIR/gdd-workflow-state" "$plan" status >/dev/null
  status_file="$workspace/workflow-v1/projections/status.tsv"
  for finding_id in $(scope_finding_ids "$slice"); do
    latest_state=$(latest_lifecycle_state "$finding_id")
    case "$latest_state" in
      REPORTED|BLOCKED) fail "finding $finding_id in $latest_state blocks slice $slice" ;;
      REPAIRING)
        [ "$(field_value 'Replay through' "$(latest_event_evidence "$finding_id" transition-repairing)")" = downstream ] || fail "finding $finding_id is REPAIRING and holds slice $slice at its review"
        permitted=$(downstream_target "$finding_id" "$slice")
        [ "$target" = "$permitted" ] || fail "finding $finding_id permits only $permitted while it is REPAIRING"
        ;;
    esac
  done
}

command_digest() {
  [ $# -eq 1 ] || usage
  output_file=$1
  require_workspace
  output_dir=$(cd "$(dirname "$output_file")" 2>/dev/null && pwd -P) \
    || fail "digest output directory does not exist: $(dirname "$output_file")"
  workspace_dir=$(cd "$workspace" && pwd -P)
  output_name=$(basename "$output_file")
  case "$output_dir/" in "$workspace_dir/"*) ;; *) fail 'digest output must be inside the finding workspace' ;; esac
  for finding_id in $(awk -F '\t' '{ seen[$1]=1 } END { for (id in seen) print id }' "$ledger" | sort); do
    case "$(latest_lifecycle_state "$finding_id")" in REPORTED|REPAIRING|BLOCKED) fail "digest cannot be written while $finding_id is $(latest_lifecycle_state "$finding_id")" ;; esac
  done
  stage_dir=$(mktemp -d "$workspace/.digest-stage.XXXXXX")
  staged_output="$stage_dir/$output_name"
  {
    printf '## Findings left unchanged\n\n'
    number=0
    for finding_id in $(awk -F '\t' '{ seen[$1]=1 } END { for (id in seen) print id }' "$ledger" | sort); do
      state=$(latest_lifecycle_state "$finding_id")
      case "$state" in DEFERRED|DISMISSED|PARKED) ;; *) continue ;; esac
      number=$((number + 1))
      origin=$(finding_origin "$finding_id")
      report_file=$(latest_event_evidence "$finding_id" report)
      terminal_file=$(latest_event_evidence "$finding_id" "transition-$(lowercase "$state")")
      printf '%s. `%s`\n' "$number" "$finding_id"
      printf '   - Origin: %s\n' "$origin"
      printf '   - Severity: %s\n' "$(field_value 'Severity claim' "$report_file")"
      printf '   - Summary: %s\n' "$(field_value 'Observed failure' "$report_file")"
      printf '   - Disposition: %s\n' "$state"
      printf '   - Reason: %s\n' "$(field_value Ruling "$terminal_file")"
      fable=$(field_value 'Fable result' "$terminal_file")
      printf '   - Fable: %s\n' "${fable:-NOT REQUIRED}"
      printf '   - Cost if wrong: %s\n' "$(field_value 'Cost if wrong' "$terminal_file")"
      printf '   - Wake condition: %s\n\n' "$(field_value 'Wake condition' "$terminal_file")"
    done
    [ "$number" -gt 0 ] || printf 'None.\n'
    printf '\n## Advisor consultations\n\n'
    consult_number=0
    for finding_id in $(awk -F '\t' '{ seen[$1] = 1 } END { for (id in seen) print id }' "$ledger" | sort); do
      for consult_dir in $(find "$findings_dir/$finding_id/events" -mindepth 1 -maxdepth 1 -type d -name '*-consult-*' 2>/dev/null | sort); do
        consult_number=$((consult_number + 1))
        consult_file="$consult_dir/evidence.md"
        printf '%s. `%s`\n' "$consult_number" "$finding_id"
        printf '   - Finding IDs: %s\n' "$(field_value 'Finding IDs' "$consult_file")"
        printf '   - Case: %s\n' "$(field_value Case "$consult_file")"
        printf '   - Decision: %s\n' "$(field_value Decision "$consult_file")"
        printf '   - Reason: %s\n' "$(field_value Reason "$consult_file")"
        printf '   - Cost if wrong: %s\n\n' "$(field_value 'Cost if wrong' "$consult_file")"
      done
    done
    [ "$consult_number" -gt 0 ] || printf 'None.\n'
  } >"$staged_output"
  obligation=$(active_obligation)
  [ "$obligation" = feature-findings-digest ] || fail "digest requires active obligation feature-findings-digest: $obligation"
  digest_finding_id=$(awk -F '\t' '$4 == "DEFERRED" || $4 == "DISMISSED" || $4 == "PARKED" { id=$1 } END { print id }' "$ledger")
  if [ -n "$digest_finding_id" ]; then
    GDD_FINDING_ID="$digest_finding_id" \
    GDD_FINDING_SCOPE="$(finding_scope "$digest_finding_id")" \
    GDD_FINDING_ORIGIN="$(finding_origin "$digest_finding_id")" \
    GDD_FINDING_STATE="$(latest_lifecycle_state "$digest_finding_id")" \
    GDD_FINDING_EVENT_NAME=digest \
      "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" FindingsDigestWritten "$staged_output" >/dev/null
  else
    "$SCRIPT_DIR/gdd-workflow-state" "$plan" accept-active "$obligation" FindingsDigestWritten "$staged_output" >/dev/null
  fi
  mv "$staged_output" "$output_dir/$output_name"
  rmdir "$stage_dir"
}

[ $# -ge 2 ] || usage
plan=$1
command=$2
shift 2
workspace=$(resolve_workspace_path "$plan")
repo_root=$(git -C "$(dirname "$plan")" rev-parse --show-toplevel)
ledger="$workspace/findings.tsv"
findings_dir="$workspace/findings"

case "$command" in
  init) command_init "$@" ;;
  report) command_report "$@" ;;
  supplement) command_supplement "$@" ;;
  transition) command_transition "$@" ;;
  consult) command_consult "$@" ;;
  repair-start) command_repair_start "$@" ;;
  repair-result) command_repair_result "$@" ;;
  repair-finish) command_repair_finish "$@" ;;
  guard) command_guard "$@" ;;
  digest) command_digest "$@" ;;
  *) usage ;;
esac
